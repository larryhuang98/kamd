+ * This file is part of the GROMACS molecular simulation package.
+ *
+ * KAMD (Kinetically Accelerated Molecular Dynamics) for GROMACS.
+ * Port of the pmemd.cuda implementation by Zhen Huang, Haixin Wei and Ray Luo (UC Irvine).
+ * Method: H. Wei et al., bioRxiv 2025, doi:10.1101/2025.06.14.659665.
+ *
+ * GROMACS is free software; you can redistribute it and/or modify it under the terms of the
+ * GNU Lesser General Public License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+/*! \internal \file
+ * \brief Declares the KAMD pseudo-Brownian-dynamics velocity reset for the leap-frog integrators.
+ *
+ * Every pseudobd-cycles steps the translational momentum of each reference group is projected on
+ * the velocity of the reference centre of mass; once every group has registered nzero-crossings
+ * sign changes of that projection, all velocities are redrawn from Maxwell-Boltzmann and the
+ * first-shell bath atoms and surface reference atoms of each group are given a common random
+ * direction with their speed preserved.  See doc/kamd in the patch for the full description.
+ */
+#ifndef GMX_MDRUN_KAMD_H
+#define GMX_MDRUN_KAMD_H
+
+#include <cstdint>
+#include <cstdio>
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "gromacs/utility/arrayref.h"
+#include "gromacs/utility/real.h"
+#include "gromacs/utility/vectypes.h"
+
+struct t_inputrec;
+
+namespace gmx
+{
+
+//! Region types, same numbering as the Amber &kamd namelist.
+enum class KamdRegion : int
+{
+    Solution      = 1,
+    Transmembrane = 2
+};
+
+//! Parsed and validated KAMD settings (lengths in nm).
+struct KamdParameters
+{
+    int                           pseudobdCycles = 250;
+    int                           nzeroCrossings = 2;
+    double                        shellCut       = 0.5;
+    double                        surfaceCut     = 0.3;
+    double                        membraneCut    = 0.3;
+    int                           membraneAxis   = -1; //!< 0,1,2 or -1 if unset
+    double                        temperature    = -1;
+    int64_t                       seed           = -1;
+    std::vector<std::vector<int>> groups;     //!< 0-based global atom indices per reference group
+    std::vector<std::string>      groupNames; //!< for the log
+    std::vector<int>              link;       //!< 1-based, 0 = own direction
+    std::vector<KamdRegion>       region;
+    std::vector<int>              solvent;
+    std::vector<int>              membrane;
+    std::string                   logFile   = "kamd.log";
+    bool                          writeDiag = false;
+};
+
+/*! \brief Read a KAMD input file (key = value) and the index file it names.
+ *
+ * Throws InvalidInputError with a message mirroring the pmemd &kamd checks.
+ */
+KamdParameters readKamdParameters(const std::string& fileName, const t_inputrec& ir, int numAtoms);
+
+//! Result of a first-shell search: per atom 0 = untouched, g+1 = bath atom of group g, -(g+1) = surface ref atom of group g.
+std::vector<int> kamdFindFirstShell(const KamdParameters& p, ArrayRef<const RVec> x, const matrix box);
+
+/*! \brief KAMD driver used by the md integrator loop.
+ *
+ * All arrays passed in are in local (home-atom) order; \p localToGlobal maps them to global
+ * atom indices (empty = identity).  All home atoms of the system must be on this rank,
+ * i.e. a single PP rank, with or without the DD atom ordering GROMACS uses on one rank.
+ */
+class Kamd
+{
+public:
+    Kamd(KamdParameters parameters, int numAtoms, double timeStep, FILE* fplog);
+    ~Kamd();
+
+    //! Whether the momentum monitor runs at this step (stepRel counted from the start of this run).
+    bool isCheckStep(int64_t stepRel) const;
+
+    //! Register a momentum check with the current (half-step) velocities; returns true if a reset must happen now.
+    bool checkMomenta(int64_t              step,
+                      ArrayRef<const int>  localToGlobal,
+                      ArrayRef<const real> massLocal,
+                      ArrayRef<const RVec> v);
+
+    /*! \brief Pseudo-BD reset: new velocities written to \p v.
+     *
+     * \p x and \p f are the coordinates and forces at this step, \p v holds v(t - dt/2).
+     */
+    void resetVelocities(int64_t              step,
+                         ArrayRef<const int>  localToGlobal,
+                         ArrayRef<const real> massLocal,
+                         ArrayRef<const RVec> x,
+                         ArrayRef<const RVec> f,
+                         const matrix         box,
+                         ArrayRef<RVec>       v);
+
+    int numResets() const { return numResets_; }
+
+private:
+    //! Global masses and group masses from local data (once).
+    void setMasses(ArrayRef<const int> localToGlobal, ArrayRef<const real> massLocal);
+    //! global index -> local index
+    const std::vector<int>& globalToLocal(ArrayRef<const int> localToGlobal);
+
+    KamdParameters      p_;
+    int                 numAtoms_;
+    std::vector<int>    g2l_;
+    std::vector<double> mass_;
+    std::vector<double> groupMass_;
+    std::vector<double> last_;
+    std::vector<int>    count_;
+    double              timeStep_;
+    FILE*               log_       = nullptr;
+    int                 numResets_ = 0;
+    double              resetMs_   = 0;
+    bool                diagDone_  = false;
+};
+
+} // namespace gmx
+
+#endif
