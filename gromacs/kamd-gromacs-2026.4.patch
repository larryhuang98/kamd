+// ------------------------------------------------------------------ first-shell search
+
+/*! \brief Straightforward O(N_ref x N_bath) reference with the same conventions as pmemd:
+ * strict < cutoffs, nearest reference atom wins, ties to the lower group, fractional
+ * minimum image.  Returns the per-atom record (g+1 bath, -(g+1) surface, 0 untouched).
+ */
+std::vector<int> referenceFirstShell(const KamdParameters& p, const std::vector<RVec>& x, const matrix box)
+{
+    double inv[3][3];
+    {
+        const double a = box[0][0], b = box[1][1], c = box[2][2];
+        inv[0][0] = 1 / a;
+        inv[1][1] = 1 / b;
+        inv[2][2] = 1 / c;
+        inv[0][1] = inv[0][2] = inv[1][2] = 0;
+        inv[1][0]                         = -box[1][0] / (a * b);
+        inv[2][1]                         = -box[2][1] / (b * c);
+        inv[2][0] = (box[1][0] * box[2][1] - box[1][1] * box[2][0]) / (a * b * c);
+    }
+    auto dist2 = [&](int i, int j)
+    {
+        double d[3], f[3], r2 = 0;
+        for (int k = 0; k < 3; k++)
+        {
+            d[k] = static_cast<double>(x[i][k]) - x[j][k];
+        }
+        for (int k = 0; k < 3; k++)
+        {
+            f[k] = d[0] * inv[0][k] + d[1] * inv[1][k] + d[2] * inv[2][k];
+            f[k] -= std::round(f[k]);
+        }
+        for (int k = 0; k < 3; k++)
+        {
+            const double dk = f[0] * box[0][k] + f[1] * box[1][k] + f[2] * box[2][k];
+            r2 += dk * dk;
+        }
+        return r2;
+    };
+    std::vector<int> record(x.size(), 0);
+    for (KamdRegion region : { KamdRegion::Solution, KamdRegion::Transmembrane })
+    {
+        const auto& bath = region == KamdRegion::Solution ? p.solvent : p.membrane;
+        const double acut2 = std::pow(region == KamdRegion::Solution ? p.shellCut : p.membraneCut, 2);
+        const double scut2 = std::pow(region == KamdRegion::Solution ? p.surfaceCut : p.membraneCut, 2);
+        for (int b : bath)
+        {
+            double best  = acut2;
+            int    bestG = -1;
+            for (size_t g = 0; g < p.groups.size(); g++)
+            {
+                if (p.region[g] != region)
+                {
+                    continue;
+                }
+                for (int r : p.groups[g])
+                {
+                    const double r2 = dist2(b, r);
+                    if (r2 < best)
+                    {
+                        best  = r2;
+                        bestG = static_cast<int>(g);
+                    }
+                }
+            }
+            if (bestG >= 0)
+            {
+                record[b] = bestG + 1;
+            }
+        }
+        for (size_t g = 0; g < p.groups.size(); g++)
+        {
+            if (p.region[g] != region)
+            {
+                continue;
+            }
+            for (int r : p.groups[g])
+            {
+                for (int b : bath)
+                {
+                    if (dist2(r, b) < scut2)
+                    {
+                        record[r] = -static_cast<int>(g + 1);
+                        break;
+                    }
+                }
+            }
+        }
+    }
+    return record;
+}
