+// ------------------------------------------------------------------------ input parsing
+std::string normalizeKey(std::string k)
+{
+    std::transform(k.begin(),
+                   k.end(),
+                   k.begin(),
+                   [](unsigned char c)
+                   { return c == '_' ? '-' : static_cast<char>(std::tolower(c)); });
+    return k;
+}
+
+std::string trim(const std::string& s)
+{
+    const auto b = s.find_first_not_of(" \t\r\n");
+    if (b == std::string::npos)
+    {
+        return "";
+    }
+    const auto e = s.find_last_not_of(" \t\r\n");
+    return s.substr(b, e - b + 1);
+}
+
+std::vector<std::string> splitWords(const std::string& s)
+{
+    std::istringstream       is(s);
+    std::vector<std::string> out;
+    std::string              w;
+    while (is >> w)
+    {
+        out.push_back(w);
+    }
+    return out;
+}
+
+std::map<std::string, std::string> readKeyValueFile(const std::string& fileName)
+{
+    std::ifstream in(fileName);
+    if (!in)
+    {
+        GMX_THROW(FileIOError(formatString("KAMD: cannot open input file '%s'", fileName.c_str())));
+    }
+    std::map<std::string, std::string> kv;
+    std::string                        line;
+    int                                lineNumber = 0;
+    while (std::getline(in, line))
+    {
+        lineNumber++;
+        const auto c = line.find_first_of(";#");
+        if (c != std::string::npos)
+        {
+            line.erase(c);
+        }
+        line = trim(line);
+        if (line.empty())
+        {
+            continue;
+        }
+        const auto eq = line.find('=');
+        if (eq == std::string::npos)
+        {
+            GMX_THROW(InvalidInputError(formatString(
+                    "KAMD: line %d of '%s' is not 'key = value'", lineNumber, fileName.c_str())));
+        }
+        const std::string key = normalizeKey(trim(line.substr(0, eq)));
+        if (kv.count(key))
+        {
+            GMX_THROW(InvalidInputError(formatString("KAMD: key '%s' given twice", key.c_str())));
+        }
+        kv[key] = trim(line.substr(eq + 1));
+    }
+    return kv;
+}
+
+//! Minimal .ndx reader: name -> 0-based atom indices.
+std::vector<std::pair<std::string, std::vector<int>>> readIndexFile(const std::string& fileName)
+{
+    std::ifstream in(fileName);
+    if (!in)
+    {
+        GMX_THROW(FileIOError(formatString("KAMD: cannot open index file '%s'", fileName.c_str())));
+    }
+    std::vector<std::pair<std::string, std::vector<int>>> groups;
+    std::string                                           line;
+    while (std::getline(in, line))
+    {
+        line = trim(line);
+        if (line.empty())
+        {
+            continue;
+        }
+        if (line.front() == '[')
+        {
+            const auto e = line.find(']');
+            groups.emplace_back(trim(line.substr(1, e == std::string::npos ? std::string::npos : e - 1)),
+                                std::vector<int>());
+            continue;
+        }
+        if (groups.empty())
+        {
+            GMX_THROW(InvalidInputError(formatString("KAMD: '%s' is not an index file", fileName.c_str())));
+        }
+        for (const auto& w : splitWords(line))
+        {
+            size_t pos  = 0;
+            long   atom = 0;
+            try
+            {
+                atom = std::stol(w, &pos);
+            }
+            catch (const std::exception&)
+            {
+                pos = 0;
+            }
+            if (pos != w.size() || atom < 1)
+            {
+                GMX_THROW(InvalidInputError(
+                        formatString("KAMD: invalid atom number '%s' in group [ %s ] of '%s'",
+                                     w.c_str(),
+                                     groups.back().first.c_str(),
+                                     fileName.c_str())));
+            }
+            groups.back().second.push_back(static_cast<int>(atom - 1));
+        }
+    }
+    return groups;
+}
+
+std::vector<int> findGroup(const std::vector<std::pair<std::string, std::vector<int>>>& ndx,
+                           const std::string&                                           name,
+                           const std::string&                                           what)
+{
+    for (const auto& g : ndx)
+    {
+        if (g.first == name)
+        {
+            return g.second;
+        }
+    }
+    for (const auto& g : ndx)
+    {
+        if (equalCaseInsensitive(g.first, name))
+        {
+            return g.second;
+        }
+    }
+    GMX_THROW(InvalidInputError(formatString(
+            "KAMD: %s group '%s' not found in the index file", what.c_str(), name.c_str())));
+}
+
+std::vector<int> sortedUnique(std::vector<int> v)
+{
+    std::sort(v.begin(), v.end());
+    v.erase(std::unique(v.begin(), v.end()), v.end());
+    return v;
+}
+
+bool intersects(const std::vector<int>& a, const std::vector<int>& b)
+{
+    std::vector<int> out;
+    std::set_intersection(a.begin(), a.end(), b.begin(), b.end(), std::back_inserter(out));
+    return !out.empty();
+}
+
+// ------------------------------------------------------------------------ geometry
+struct Box
+{
+    double a[3][3]; // rows are box vectors (GROMACS convention)
+    double inv[3][3];
+    bool   rect;
+    double L[3];
+};
+
+Box makeBox(const matrix box)
+{
+    Box b;
+    for (int i = 0; i < 3; i++)
+    {
+        for (int j = 0; j < 3; j++)
+        {
+            b.a[i][j] = box[i][j];
+        }
+        b.L[i] = box[i][i];
+    }
+    b.rect = (box[YY][XX] == 0 && box[ZZ][XX] == 0 && box[ZZ][YY] == 0 && box[XX][YY] == 0
+              && box[XX][ZZ] == 0 && box[YY][ZZ] == 0);
+    // inverse of the lower-triangular box matrix (row vectors): frac = d * inv
+    const double(*m)[3] = b.a;
+    const double det    = m[0][0] * m[1][1] * m[2][2];
+    GMX_RELEASE_ASSERT(det > 0, "KAMD: invalid box");
+    double inv[3][3] = { { 0 } };
+    inv[0][0]        = 1 / m[0][0];
+    inv[1][1]        = 1 / m[1][1];
+    inv[2][2]        = 1 / m[2][2];
+    inv[1][0]        = -m[1][0] / (m[0][0] * m[1][1]);
+    inv[2][1]        = -m[2][1] / (m[1][1] * m[2][2]);
+    inv[2][0]        = (m[1][0] * m[2][1] - m[1][1] * m[2][0]) / det;
+    for (int i = 0; i < 3; i++)
+    {
+        for (int j = 0; j < 3; j++)
+        {
+            b.inv[i][j] = inv[i][j];
+        }
+    }
+    return b;
+}
+
+inline double minImageDist2(const Box& b, const double* xi, const double* xj)
+{
+    double d[3] = { xi[0] - xj[0], xi[1] - xj[1], xi[2] - xj[2] };
+    if (b.rect)
+    {
+        for (int k = 0; k < 3; k++)
+        {
+            d[k] -= b.L[k] * std::round(d[k] / b.L[k]);
+        }
+        return d[0] * d[0] + d[1] * d[1] + d[2] * d[2];
+    }
+    // fractional rounding, same convention as kKAMD.h: f = d * inv, f -= round(f), d = f * box
+    double f[3];
+    for (int j = 0; j < 3; j++)
+    {
+        f[j] = d[0] * b.inv[0][j] + d[1] * b.inv[1][j] + d[2] * b.inv[2][j];
+        f[j] -= std::round(f[j]);
+    }
+    double r2 = 0;
+    for (int j = 0; j < 3; j++)
+    {
+        const double dj = f[0] * b.a[0][j] + f[1] * b.a[1][j] + f[2] * b.a[2][j];
+        r2 += dj * dj;
+    }
+    return r2;
+}
+
+/*! \brief For every query atom, the nearest point atom with r < cut.
+ *
+ * Returns, per query, the position in \p points of the nearest atom (-1 if none).
+ * Ties keep the earlier entry of \p points (pmemd breaks ties toward the lower group).
+ */
+std::vector<int> nearestWithin(const std::vector<int>&    query,
+                               const std::vector<int>&    points,
+                               const std::vector<double>& xyz,
+                               const Box&                 box,
+                               double                     cut)
+{
+    std::vector<int> best(query.size(), -1);
+    if (query.empty() || points.empty())
+    {
+        return best;
+    }
+    const double cut2    = cut * cut;
+    int          n[3]    = { 0, 0, 0 };
+    bool         useGrid = box.rect;
+    for (int d = 0; d < 3 && useGrid; d++)
+    {
+        n[d]    = static_cast<int>(std::floor(box.L[d] / cut));
+        useGrid = n[d] >= 3;
+    }
+    if (!useGrid)
+    {
+#pragma omp parallel for schedule(static)
+        for (size_t q = 0; q < query.size(); q++)
+        {
+            double bestR2 = cut2;
+            for (size_t p = 0; p < points.size(); p++)
+            {
+                const double r2 = minImageDist2(box, &xyz[3 * query[q]], &xyz[3 * points[p]]);
+                if (r2 < bestR2)
+                {
+                    bestR2  = r2;
+                    best[q] = static_cast<int>(p);
+                }
+            }
+        }
+        return best;
+    }
+    auto cellOf = [&](const double* x, int* c)
+    {
+        for (int d = 0; d < 3; d++)
+        {
+            double w = x[d] - box.L[d] * std::floor(x[d] / box.L[d]);
+            c[d]     = std::min(n[d] - 1, std::max(0, static_cast<int>(w / box.L[d] * n[d])));
+        }
+    };
+    const int        ncell = n[0] * n[1] * n[2];
+    std::vector<int> cellStart(ncell + 1, 0), cellOfPoint(points.size()), sorted(points.size());
+    for (size_t p = 0; p < points.size(); p++)
+    {
+        int c[3];
+        cellOf(&xyz[3 * points[p]], c);
+        cellOfPoint[p] = (c[2] * n[1] + c[1]) * n[0] + c[0];
+        cellStart[cellOfPoint[p] + 1]++;
+    }
+    for (int c = 0; c < ncell; c++)
+    {
+        cellStart[c + 1] += cellStart[c];
+    }
+    {
+        std::vector<int> fill(cellStart.begin(), cellStart.end() - 1);
+        for (size_t p = 0; p < points.size(); p++) // stable: keeps the order of points within a cell
+        {
+            sorted[fill[cellOfPoint[p]]++] = static_cast<int>(p);
+        }
+    }
+#pragma omp parallel for schedule(static)
+    for (size_t q = 0; q < query.size(); q++)
+    {
+        const double* xq = &xyz[3 * query[q]];
+        int           c[3];
+        cellOf(xq, c);
+        double bestR2 = cut2;
+        int    bestP  = -1;
+        for (int dz = -1; dz <= 1; dz++)
+        {
+            const int cz = (c[2] + dz + n[2]) % n[2];
+            for (int dy = -1; dy <= 1; dy++)
+            {
+                const int cy = (c[1] + dy + n[1]) % n[1];
+                for (int dx = -1; dx <= 1; dx++)
+                {
+                    const int cx   = (c[0] + dx + n[0]) % n[0];
+                    const int cell = (cz * n[1] + cy) * n[0] + cx;
+                    for (int s = cellStart[cell]; s < cellStart[cell + 1]; s++)
+                    {
+                        const int    p  = sorted[s];
+                        const double r2 = minImageDist2(box, xq, &xyz[3 * points[p]]);
+                        if (r2 < bestR2 || (r2 == bestR2 && bestP >= 0 && p < bestP))
+                        {
+                            bestR2 = r2;
+                            bestP  = p;
+                        }
+                    }
+                }
+            }
+        }
+        best[q] = bestP;
+    }
+    return best;
+}
+
+double dot3(const double* a, const double* b)
+{
+    return a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+}
+
+} // namespace
+
+// ------------------------------------------------------------------------ parameters
+KamdParameters readKamdParameters(const std::string& fileName, const t_inputrec& ir, int numAtoms)
+{
+    auto           kv = readKeyValueFile(fileName);
+    KamdParameters p;
+    auto           take = [&kv](const std::string& key) -> std::string
+    {
+        auto it = kv.find(key);
+        if (it == kv.end())
+        {
+            return "";
+        }
+        std::string v = it->second;
+        kv.erase(it);
+        return v;
+    };
+    auto toInt = [](const std::string& s, const char* key)
+    {
+        try
+        {
+            size_t pos;
+            int    v = std::stoi(s, &pos);
+            if (pos != s.size())
+            {
+                throw std::invalid_argument(s);
+            }
+            return v;
+        }
+        catch (const std::exception&)
+        {
+            GMX_THROW(InvalidInputError(formatString("KAMD: '%s' is not an integer for %s", s.c_str(), key)));
+        }
+    };
+    auto toDouble = [](const std::string& s, const char* key)
+    {
+        try
+        {
+            size_t pos;
+            double v = std::stod(s, &pos);
+            if (pos != s.size())
+            {
+                throw std::invalid_argument(s);
+            }
+            return v;
+        }
+        catch (const std::exception&)
+        {
+            GMX_THROW(InvalidInputError(formatString("KAMD: '%s' is not a number for %s", s.c_str(), key)));
+        }
+    };
+
+    std::string v;
+    if (!(v = take("pseudobd-cycles")).empty())
+    {
+        p.pseudobdCycles = toInt(v, "pseudobd-cycles");
+    }
+    if (!(v = take("nzero-crossings")).empty())
+    {
+        p.nzeroCrossings = toInt(v, "nzero-crossings");
+    }
+    if (!(v = take("shell-cut")).empty())
+    {
+        p.shellCut = toDouble(v, "shell-cut");
+    }
+    if (!(v = take("surface-cut")).empty())
+    {
+        p.surfaceCut = toDouble(v, "surface-cut");
+    }
+    if (!(v = take("membrane-cut")).empty())
+    {
+        p.membraneCut = toDouble(v, "membrane-cut");
+    }
+    if (!(v = take("membrane-axis")).empty())
+    {
+        const std::string a = normalizeKey(v);
+        p.membraneAxis      = (a == "x" || a == "1")   ? 0
+                              : (a == "y" || a == "2") ? 1
+                              : (a == "z" || a == "3") ? 2
+                                                       : -2;
+        if (p.membraneAxis == -2)
+        {
+            GMX_THROW(InvalidInputError(
+                    formatString("KAMD: membrane-axis = %s is invalid (x, y or z)", v.c_str())));
+        }
+    }
+    if (!(v = take("temperature")).empty())
+    {
+        p.temperature = toDouble(v, "temperature");
+    }
+    if (!(v = take("seed")).empty())
+    {
+        size_t pos = 0;
+        try
+        {
+            p.seed = std::stoll(v, &pos);
+        }
+        catch (const std::exception&)
+        {
+            pos = 0;
+        }
+        if (pos != v.size())
+        {
+            GMX_THROW(InvalidInputError(formatString("KAMD: '%s' is not an integer for seed", v.c_str())));
+        }
+    }
+    if (!(v = take("log")).empty())
+    {
+        p.logFile = v;
+    }
+    if (!(v = take("diag")).empty())
+    {
+        const std::string a = normalizeKey(v);
+        p.writeDiag         = (a == "yes" || a == "true" || a == "1");
+    }
+
+    const std::string indexFile    = take("index");
+    const auto        groupNames   = splitWords(take("refer-groups"));
+    const std::string solventName  = take("solvent-group");
+    const std::string membraneName = take("membrane-group");
+    const auto        linkWords    = splitWords(take("refer-link"));
+    const auto        regionWords  = splitWords(take("region-type"));
+
+    if (!kv.empty())
+    {
+        GMX_THROW(InvalidInputError(formatString(
+                "KAMD: unknown key '%s' in '%s'", kv.begin()->first.c_str(), fileName.c_str())));
+    }
+
+    // ---- checks mirroring pmemd's &kamd validation
+    if (p.pseudobdCycles <= 0)
+    {
+        GMX_THROW(InvalidInputError("KAMD: pseudobd-cycles must be > 0"));
+    }
+    if (p.nzeroCrossings <= 0)
+    {
+        GMX_THROW(InvalidInputError("KAMD: nzero-crossings must be > 0"));
+    }
+    if (p.shellCut <= 0 || p.surfaceCut <= 0)
+    {
+        GMX_THROW(InvalidInputError("KAMD: shell-cut and surface-cut must be > 0"));
+    }
+    if (p.surfaceCut > p.shellCut)
+    {
+        GMX_THROW(InvalidInputError("KAMD: surface-cut must be <= shell-cut"));
+    }
+    if (indexFile.empty())
+    {
+        GMX_THROW(InvalidInputError("KAMD: 'index = file.ndx' is required"));
+    }
+    if (groupNames.empty())
+    {
+        GMX_THROW(InvalidInputError("KAMD: refer-groups must list at least one index group"));
+    }
+    if (solventName.empty())
+    {
+        GMX_THROW(InvalidInputError("KAMD: solvent-group is required"));
+    }
+
+    const auto ndx = readIndexFile(indexFile);
+    const int  ng  = static_cast<int>(groupNames.size());
+    for (const auto& name : groupNames)
+    {
+        p.groups.push_back(sortedUnique(findGroup(ndx, name, "reference")));
+        p.groupNames.push_back(name);
+        if (p.groups.back().empty())
+        {
+            GMX_THROW(InvalidInputError(formatString("KAMD: reference group '%s' is empty", name.c_str())));
+        }
+    }
+    p.solvent = sortedUnique(findGroup(ndx, solventName, "solvent"));
+    if (!membraneName.empty())
+    {
+        p.membrane = sortedUnique(findGroup(ndx, membraneName, "membrane"));
+    }
+
+    p.link.assign(ng, 0);
+    if (!linkWords.empty())
+    {
+        if (static_cast<int>(linkWords.size()) != ng)
+        {
+            GMX_THROW(InvalidInputError("KAMD: refer-link needs one entry per reference group"));
+        }
+        for (int g = 0; g < ng; g++)
+        {
+            p.link[g] = toInt(linkWords[g], "refer-link");
+            if (p.link[g] < 0 || p.link[g] > ng)
+            {
+                GMX_THROW(InvalidInputError(formatString(
+                        "KAMD: refer-link(%d) = %d is out of range [0, %d]", g + 1, p.link[g], ng)));
+            }
+            if (p.link[g] == g + 1)
+            {
+                GMX_THROW(InvalidInputError(
+                        formatString("KAMD: refer-link(%d) cannot reference its own group", g + 1)));
+            }
+        }
+    }
+    p.region.assign(ng, KamdRegion::Solution);
+    if (!regionWords.empty())
+    {
+        if (static_cast<int>(regionWords.size()) != ng)
+        {
+            GMX_THROW(InvalidInputError("KAMD: region-type needs one entry per reference group"));
+        }
+        for (int g = 0; g < ng; g++)
+        {
+            const int r = toInt(regionWords[g], "region-type");
+            if (r != 1 && r != 2)
+            {
+                GMX_THROW(InvalidInputError(formatString(
+                        "KAMD: region-type(%d) = %d is invalid (1=solution, 2=transmembrane)", g + 1, r)));
+            }
+            p.region[g] = static_cast<KamdRegion>(r);
+        }
+    }
+    const bool haveTM = std::any_of(p.region.begin(),
+                                    p.region.end(),
+                                    [](KamdRegion r) { return r == KamdRegion::Transmembrane; });
+    if (haveTM)
+    {
+        if (p.membrane.empty())
+        {
+            GMX_THROW(InvalidInputError(
+                    "KAMD: membrane-group is required when any region-type is 2"));
+        }
+        if (p.membraneAxis < 0)
+        {
+            GMX_THROW(InvalidInputError(
+                    "KAMD: membrane-axis (x, y or z) is required when any region-type is 2"));
+        }
+        if (p.membraneCut <= 0)
+        {
+            GMX_THROW(InvalidInputError("KAMD: membrane-cut must be > 0"));
+        }
+    }
+
+    std::vector<int> allRef;
+    for (int g = 0; g < ng; g++)
+    {
+        for (int h = g + 1; h < ng; h++)
+        {
+            if (intersects(p.groups[g], p.groups[h]))
+            {
+                GMX_THROW(
+                        InvalidInputError(formatString("KAMD: reference groups %d and %d overlap; "
+                                                       "reference groups must not overlap",
+                                                       g + 1,
+                                                       h + 1)));
+            }
+        }
+        allRef.insert(allRef.end(), p.groups[g].begin(), p.groups[g].end());
+    }
+    allRef = sortedUnique(allRef);
+    if (intersects(allRef, p.solvent))
+    {
+        GMX_THROW(InvalidInputError("KAMD: reference groups and solvent bath overlap"));
+    }
+    if (intersects(allRef, p.membrane))
+    {
+        GMX_THROW(InvalidInputError("KAMD: reference groups and membrane bath overlap"));
+    }
+    if (intersects(p.solvent, p.membrane))
+    {
+        GMX_THROW(InvalidInputError("KAMD: solvent bath and membrane bath overlap"));
+    }
+    for (const auto* list : { &allRef, &p.solvent, &p.membrane })
+    {
+        if (!list->empty() && (list->front() < 0 || list->back() >= numAtoms))
+        {
+            GMX_THROW(InvalidInputError(formatString(
+                    "KAMD: index group atom out of range for a %d-atom system", numAtoms)));
+        }
+    }
+
+    if (p.temperature < 0)
+    {
+        if (ir.opts.ngtc < 1 || ir.opts.ref_t[0] <= 0)
+        {
+            GMX_THROW(InvalidInputError("KAMD: set 'temperature' (no ref-t available)"));
+        }
+        for (int i = 1; i < ir.opts.ngtc; i++)
+        {
+            if (ir.opts.ref_t[i] != ir.opts.ref_t[0])
+            {
+                GMX_THROW(InvalidInputError(
+                        "KAMD: tc-groups have different ref-t; set 'temperature' explicitly"));
+            }
+        }
+        p.temperature = ir.opts.ref_t[0];
+    }
+    if (p.seed == -1)
+    {
+        p.seed = ir.ld_seed;
+    }
+    return p;
+}
+
+// ------------------------------------------------------------------------ first shell
+std::vector<int> kamdFindFirstShell(const KamdParameters& p, ArrayRef<const RVec> x, const matrix box)
+{
+    const Box           b = makeBox(box);
+    std::vector<double> xyz(3 * x.size());
+    for (size_t i = 0; i < x.size(); i++)
+    {
+        for (int d = 0; d < 3; d++)
+        {
+            xyz[3 * i + d] = x[i][d];
+        }
+    }
+    std::vector<int> record(x.size(), 0);
+    const int        ng = static_cast<int>(p.groups.size());
+    for (KamdRegion region : { KamdRegion::Solution, KamdRegion::Transmembrane })
+    {
+        const std::vector<int>& bath = region == KamdRegion::Solution ? p.solvent : p.membrane;
+        const double     assignCut   = region == KamdRegion::Solution ? p.shellCut : p.membraneCut;
+        const double     surfCut = region == KamdRegion::Solution ? p.surfaceCut : p.membraneCut;
+        std::vector<int> ref, refGroup;
+        for (int g = 0; g < ng; g++)
+        {
+            if (p.region[g] == region)
+            {
+                ref.insert(ref.end(), p.groups[g].begin(), p.groups[g].end());
+                refGroup.insert(refGroup.end(), p.groups[g].size(), g);
+            }
+        }
+        if (ref.empty() || bath.empty())
+        {
+            continue;
+        }
+        // bath atom -> group of the nearest reference atom within the assignment cutoff
+        const auto nearestRef = nearestWithin(bath, ref, xyz, b, assignCut);
+        for (size_t k = 0; k < bath.size(); k++)
+        {
+            if (nearestRef[k] >= 0)
+            {
+                record[bath[k]] = refGroup[nearestRef[k]] + 1;
+            }
+        }
+        // reference atom with any bath atom within the surface cutoff
+        const auto nearestBath = nearestWithin(ref, bath, xyz, b, surfCut);
+        for (size_t k = 0; k < ref.size(); k++)
+        {
+            if (nearestBath[k] >= 0)
+            {
+                record[ref[k]] = -(refGroup[k] + 1);
+            }
+        }
+    }
+    return record;
+}
+
+// ------------------------------------------------------------------------ driver
+Kamd::Kamd(KamdParameters parameters, int numAtoms, double timeStep, FILE* fplog) :
+    p_(std::move(parameters)), numAtoms_(numAtoms), timeStep_(timeStep)
+{
+    const int ng = static_cast<int>(p_.groups.size());
+    last_.assign(ng, 0.0);
+    count_.assign(ng, 0);
+    log_ = std::fopen(p_.logFile.c_str(), "w");
+    if (!log_)
+    {
+        GMX_THROW(FileIOError(formatString("KAMD: cannot write '%s'", p_.logFile.c_str())));
+    }
+    std::string sizes;
+    for (int g = 0; g < ng; g++)
+    {
+        sizes += formatString("%s%s(%zu)", g ? " " : "", p_.groupNames[g].c_str(), p_.groups[g].size());
+    }
+    const std::string summary = formatString(
+            "KAMD: %d reference groups [%s], solvent %zu atoms, membrane %zu atoms, "
+            "pseudobd-cycles %d, "
+            "nzero-crossings %d, shell/surface/membrane cut %g/%g/%g nm, T %g K, seed %lld",
+            ng,
+            sizes.c_str(),
+            p_.solvent.size(),
+            p_.membrane.size(),
+            p_.pseudobdCycles,
+            p_.nzeroCrossings,
+            p_.shellCut,
+            p_.surfaceCut,
+            p_.membraneCut,
+            p_.temperature,
+            static_cast<long long>(p_.seed));
+    std::fprintf(log_, "# %s\n", summary.c_str());
+    if (ng == 1)
+    {
+        std::fprintf(
+                log_,
+                "# WARNING: one reference group: its relative momentum is zero up to round-off, so "
+                "resets are driven by floating-point noise (same formula as pmemd). Use >= 2 "
+                "groups.\n");
+    }
+    std::fprintf(log_,
+                 "# step\tevent\tshell_atoms_per_group\tsurface_atoms_per_group\tdirections\n");
+    std::fflush(log_);
+    if (fplog)
+    {
+        std::fprintf(fplog, "\n%s\nKAMD event log: %s\n\n", summary.c_str(), p_.logFile.c_str());
+    }
+}
+
+Kamd::~Kamd()
+{
+    if (log_)
+    {
+        std::fprintf(log_, "# %d resets, %.1f ms total host time in resets\n", numResets_, resetMs_);
+        std::fclose(log_);
+    }
+}
+
+const std::vector<int>& Kamd::globalToLocal(ArrayRef<const int> localToGlobal)
+{
+    g2l_.assign(numAtoms_, -1);
+    if (localToGlobal.empty())
+    {
+        for (int i = 0; i < numAtoms_; i++)
+        {
+            g2l_[i] = i;
+        }
+    }
+    else
+    {
+        for (int l = 0; l < numAtoms_; l++)
+        {
+            g2l_[localToGlobal[l]] = l;
+        }
+    }
+    return g2l_;
+}
+
+void Kamd::setMasses(ArrayRef<const int> localToGlobal, ArrayRef<const real> massLocal)
+{
+    if (!mass_.empty())
+    {
+        return;
+    }
+    mass_.assign(numAtoms_, 0.0);
+    for (int l = 0; l < numAtoms_; l++)
+    {
+        mass_[localToGlobal.empty() ? l : localToGlobal[l]] = massLocal[l];
+    }
+    for (const auto& g : p_.groups)
+    {
+        double m = 0;
+        for (int a : g)
+        {
+            m += mass_[a];
+        }
+        groupMass_.push_back(m);
+    }
+}
+
+bool Kamd::isCheckStep(int64_t stepRel) const
+{
+    return (stepRel + 1) % p_.pseudobdCycles == 0;
+}
+
+bool Kamd::checkMomenta(int64_t /*step*/,
+                        ArrayRef<const int>  localToGlobal,
+                        ArrayRef<const real> massLocal,
+                        ArrayRef<const RVec> v)
+{
+    setMasses(localToGlobal, massLocal);
+    const auto&         g2l = globalToLocal(localToGlobal);
+    const int           ng  = static_cast<int>(p_.groups.size());
+    std::vector<double> mom(3 * ng, 0.0);
+    double              tot[3] = { 0, 0, 0 }, totMass = 0;
+    for (int g = 0; g < ng; g++)
+    {
+        for (int a : p_.groups[g])
+        {
+            for (int d = 0; d < 3; d++)
+            {
+                mom[3 * g + d] += mass_[a] * v[g2l[a]][d];
+            }
+        }
+        for (int d = 0; d < 3; d++)
+        {
+            tot[d] += mom[3 * g + d];
+        }
+        totMass += groupMass_[g];
+    }
+    const double vcom[3] = { tot[0] / totMass, tot[1] / totMass, tot[2] / totMass };
+    bool         all     = true;
+    for (int g = 0; g < ng; g++)
+    {
+        double rel[3];
+        for (int d = 0; d < 3; d++)
+        {
+            rel[d] = mom[3 * g + d] - groupMass_[g] * vcom[d];
+        }
+        if (p_.region[g] == KamdRegion::Transmembrane)
+        {
+            rel[p_.membraneAxis] = 0;
+        }
+        const double s = dot3(rel, vcom);
+        if (s * last_[g] < 0 && count_[g] < p_.nzeroCrossings)
+        {
+            count_[g]++;
+        }
+        last_[g] = s;
+        all      = all && count_[g] >= p_.nzeroCrossings;
+    }
+    return all;
+}
+
+void Kamd::resetVelocities(int64_t              step,
+                           ArrayRef<const int>  localToGlobal,
+                           ArrayRef<const real> massLocal,
+                           ArrayRef<const RVec> xLocal,
+                           ArrayRef<const RVec> f,
+                           const matrix         box,
+                           ArrayRef<RVec>       v)
+{
+    setMasses(localToGlobal, massLocal);
+    const auto&       g2l    = globalToLocal(localToGlobal);
+    const int         ng     = static_cast<int>(p_.groups.size());
+    const int         natoms = numAtoms_;
+    std::vector<RVec> x(natoms);
+#pragma omp parallel for schedule(static)
+    for (int a = 0; a < natoms; a++)
+    {
+        x[a] = xLocal[g2l[a]];
+    }
+    const double kT = c_boltz * p_.temperature;
+
+    const auto t0 = std::chrono::steady_clock::now();
+    // 1. Maxwell-Boltzmann full-step velocities (counter = step, global atom index, as Andersen)
+    std::vector<double> vfull(3 * natoms, 0.0);
+#pragma omp parallel
+    {
+        ThreeFry2x64<0>                       rngAtom(p_.seed, RandomDomain::Other);
+        TabulatedNormalDistribution<real, 14> normalAtom;
+#pragma omp for schedule(static)
+        for (int i = 0; i < natoms; i++)
+        {
+            if (mass_[i] <= 0)
+            {
+                continue;
+            }
+            rngAtom.restart(step, i);
+            normalAtom.reset();
+            const double sd = std::sqrt(kT / mass_[i]);
+            for (int d = 0; d < 3; d++)
+            {
+                vfull[3 * i + d] = sd * normalAtom(rngAtom);
+            }
+        }
+    }
+    ThreeFry2x64<0>                       rng(p_.seed, RandomDomain::Other);
+    TabulatedNormalDistribution<real, 14> normal;
+
+    // 2. one direction per group, refer-link in group order, transmembrane groups in-plane
+    std::vector<double> dir(3 * ng);
+    for (int g = 0; g < ng; g++)
+    {
+        rng.restart(step, static_cast<uint64_t>(natoms) + g);
+        normal.reset();
+        for (int d = 0; d < 3; d++)
+        {
+            dir[3 * g + d] = normal(rng);
+        }
+    }
+    for (int g = 0; g < ng; g++)
+    {
+        if (p_.link[g] > 0)
+        {
+            for (int d = 0; d < 3; d++)
+            {
+                dir[3 * g + d] = dir[3 * (p_.link[g] - 1) + d];
+            }
+        }
+    }
+    for (int g = 0; g < ng; g++)
+    {
+        double* u = &dir[3 * g];
+        double  n = std::sqrt(dot3(u, u));
+        for (int d = 0; d < 3; d++)
+        {
+            u[d] = n > 0 ? u[d] / n : 0;
+        }
+        if (p_.region[g] == KamdRegion::Transmembrane)
+        {
+            const int ax = p_.membraneAxis;
+            u[ax]        = 0;
+            n            = std::sqrt(dot3(u, u));
+            if (n > 1e-10)
+            {
+                for (int d = 0; d < 3; d++)
+                {
+                    u[d] /= n;
+                }
+            }
+            else
+            {
+                u[0] = u[1] = u[2] = 0;
+                u[ax == 0 ? 1 : 0] = 1;
+            }
+        }
+    }
+
+    const auto t1 = std::chrono::steady_clock::now();
+    // 3. first shell
+    const std::vector<int> record = kamdFindFirstShell(p_, x, box);
+    const auto             t2     = std::chrono::steady_clock::now();
+
+    // 4. speed-preserving redirect of the full-step velocities
+    std::vector<int> nShell(ng, 0), nSurf(ng, 0);
+    for (int i = 0; i < natoms; i++)
+    {
+        if (record[i] == 0 || mass_[i] <= 0)
+        {
+            continue;
+        }
+        const int     g = std::abs(record[i]) - 1;
+        double*       w = &vfull[3 * i];
+        const double* u = &dir[3 * g];
+        (record[i] > 0 ? nShell : nSurf)[g]++;
+        if (p_.region[g] == KamdRegion::Transmembrane)
+        {
+            const int    ax    = p_.membraneAxis;
+            const double vpar  = w[ax];
+            const double vperp = std::sqrt(std::max(dot3(w, w) - vpar * vpar, 0.0));
+            for (int d = 0; d < 3; d++)
+            {
+                w[d] = u[d] * vperp;
+            }
+            w[ax] += vpar;
+        }
+        else
+        {
+            const double speed = std::sqrt(dot3(w, w));
+            for (int d = 0; d < 3; d++)
+            {
+                w[d] = u[d] * speed;
+            }
+        }
+    }
+
+    // 5. leap-frog: store v(t - dt/2) = v(t) - F/m dt/2
+#pragma omp parallel for schedule(static)
+    for (int i = 0; i < natoms; i++)
+    {
+        const int    l = g2l[i];
+        const double c = mass_[i] > 0 ? 0.5 * timeStep_ / mass_[i] : 0.0;
+        for (int d = 0; d < 3; d++)
+        {
+            v[l][d] = static_cast<real>(vfull[3 * i + d] - c * f[l][d]);
+        }
+    }
+
+    const auto t3 = std::chrono::steady_clock::now();
+    auto ms = [](auto a, auto b) { return std::chrono::duration<double, std::milli>(b - a).count(); };
+    resetMs_ += ms(t0, t3);
+    // 6. reset the monitor
+    std::fill(last_.begin(), last_.end(), 0.0);
+    std::fill(count_.begin(), count_.end(), 0);
+    numResets_++;
+
+    std::string s1, s2, s3;
+    for (int g = 0; g < ng; g++)
+    {
+        s1 += formatString("%s%d", g ? "," : "", nShell[g]);
+        s2 += formatString("%s%d", g ? "," : "", nSurf[g]);
+        s3 += formatString("%s[%.6f,%.6f,%.6f]", g ? "," : "", dir[3 * g], dir[3 * g + 1], dir[3 * g + 2]);
+    }
+    std::fprintf(log_,
+                 "%lld\treset\t[%s]\t[%s]\t[%s]\tms(mb,shell,redirect)=%.2f,%.2f,%.2f\n",
+                 static_cast<long long>(step),
+                 s1.c_str(),
+                 s2.c_str(),
+                 s3.c_str(),
+                 ms(t0, t1),
+                 ms(t1, t2),
+                 ms(t2, t3));
+    std::fflush(log_);
+
+    if (p_.writeDiag && !diagDone_)
+    {
+        diagDone_ = true;
+        FILE* fp  = std::fopen("kamd_diag.txt", "w");
+        if (!fp)
+        {
+            GMX_THROW(FileIOError("KAMD: cannot write kamd_diag.txt"));
+        }
+        std::fprintf(fp, "# KAMD first-reset diagnostic, step %lld\n", static_cast<long long>(step));
+        std::fprintf(fp,
+                     "box %.9g %.9g %.9g %.9g %.9g %.9g %.9g %.9g %.9g\n",
+                     box[0][0],
+                     box[0][1],
+                     box[0][2],
+                     box[1][0],
+                     box[1][1],
+                     box[1][2],
+                     box[2][0],
+                     box[2][1],
+                     box[2][2]);
+        std::fprintf(fp,
+                     "# atom(1-based) x y z (nm) record (g>0 shell of group g, -g surface of group "
+                     "g)\n");
+        for (int i = 0; i < natoms; i++)
+        {
+            std::fprintf(fp, "%d %.9g %.9g %.9g %d\n", i + 1, x[i][0], x[i][1], x[i][2], record[i]);
+        }
+        std::fclose(fp);
+    }
+}
+
+} // namespace gmx
