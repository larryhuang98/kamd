+//! Random system: two compact groups straddling periodic boundaries, a solvent and a membrane bath.
+struct RandomSystem
+{
+    KamdParameters    p;
+    std::vector<RVec> x;
+};
+
+RandomSystem makeRandomSystem(const matrix box, int seed, bool withMembrane)
+{
+    RandomSystem                     s;
+    std::mt19937                     gen(seed);
+    std::uniform_real_distribution<> u(0, 1);
+    std::normal_distribution<>       n(0, 0.15);
+    const int                        nRef = 40, nBath = 1500, nMem = withMembrane ? 400 : 0;
+    auto                             frac = [&](double fx, double fy, double fz)
+    {
+        RVec r;
+        for (int k = 0; k < 3; k++)
+        {
+            r[k] = fx * box[0][k] + fy * box[1][k] + fz * box[2][k];
+        }
+        return r;
+    };
+    for (int i = 0; i < nRef; i++) // group 1 near x = 0, group 2 near z = L
+    {
+        RVec c = frac(0.02, 0.5, 0.5);
+        s.x.push_back({ c[0] + real(n(gen)), c[1] + real(n(gen)), c[2] + real(n(gen)) });
+    }
+    for (int i = 0; i < nRef; i++)
+    {
+        RVec c = frac(0.5, 0.5, 0.97);
+        s.x.push_back({ c[0] + real(n(gen)), c[1] + real(n(gen)), c[2] + real(n(gen)) });
+    }
+    for (int i = 0; i < nBath + nMem; i++)
+    {
+        s.x.push_back(frac(u(gen), u(gen), u(gen)));
+    }
+    s.p.groups = { {}, {} };
+    for (int i = 0; i < nRef; i++)
+    {
+        s.p.groups[0].push_back(i);
+        s.p.groups[1].push_back(nRef + i);
+    }
+    for (int i = 0; i < nBath; i++)
+    {
+        s.p.solvent.push_back(2 * nRef + i);
+    }
+    for (int i = 0; i < nMem; i++)
+    {
+        s.p.membrane.push_back(2 * nRef + nBath + i);
+    }
+    s.p.link = { 0, 0 };
+    s.p.region = { KamdRegion::Solution, withMembrane ? KamdRegion::Transmembrane : KamdRegion::Solution };
+    s.p.membraneAxis = 2;
+    s.p.membraneCut  = 0.4;
+    s.p.temperature  = 300;
+    s.p.seed         = 11;
+    return s;
+}
+
+void expectSameRecord(const std::vector<int>& expected, const std::vector<int>& actual)
+{
+    ASSERT_EQ(expected.size(), actual.size());
+    int nShell = 0, nSurf = 0;
+    for (size_t i = 0; i < expected.size(); i++)
+    {
+        EXPECT_EQ(expected[i], actual[i]) << "atom " << i;
+        nShell += expected[i] > 0;
+        nSurf += expected[i] < 0;
+    }
+    // the test is only meaningful if both kinds of atoms occur
+    EXPECT_GT(nShell, 0);
+    EXPECT_GT(nSurf, 0);
+}
