+TEST(KamdFirstShellTest, CellSearchMatchesReferenceInRectangularBox)
+{
+    const matrix box = { { 3.1, 0, 0 }, { 0, 2.9, 0 }, { 0, 0, 3.3 } }; // >= 3 cells of 0.5 nm
+    for (int seed : { 1, 2, 3 })
+    {
+        auto s = makeRandomSystem(box, seed, false);
+        expectSameRecord(referenceFirstShell(s.p, s.x, box), kamdFindFirstShell(s.p, s.x, box));
+    }
+}
+
+TEST(KamdFirstShellTest, BruteForceMatchesReferenceInSmallBox)
+{
+    const matrix box = { { 1.2, 0, 0 }, { 0, 1.3, 0 }, { 0, 0, 1.4 } }; // < 3 cells: brute force
+    auto         s   = makeRandomSystem(box, 4, false);
+    expectSameRecord(referenceFirstShell(s.p, s.x, box), kamdFindFirstShell(s.p, s.x, box));
+}
+
+TEST(KamdFirstShellTest, MatchesReferenceInTriclinicBox)
+{
+    const matrix box = { { 3.0, 0, 0 }, { 0.6, 2.8, 0 }, { -0.4, 0.5, 3.1 } };
+    auto         s   = makeRandomSystem(box, 5, false);
+    expectSameRecord(referenceFirstShell(s.p, s.x, box), kamdFindFirstShell(s.p, s.x, box));
+}
+
+TEST(KamdFirstShellTest, TransmembraneGroupUsesMembraneBathOnly)
+{
+    const matrix box = { { 3.1, 0, 0 }, { 0, 2.9, 0 }, { 0, 0, 3.3 } };
+    auto         s   = makeRandomSystem(box, 6, true);
+    const auto   rec = kamdFindFirstShell(s.p, s.x, box);
+    expectSameRecord(referenceFirstShell(s.p, s.x, box), rec);
+    for (int b : s.p.solvent)
+    {
+        EXPECT_TRUE(rec[b] == 0 || rec[b] == 1) << "solvent atom assigned to the TM group";
+    }
+    for (int m : s.p.membrane)
+    {
+        EXPECT_TRUE(rec[m] == 0 || rec[m] == 2) << "membrane atom assigned to the solution group";
+    }
+}
