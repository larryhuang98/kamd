+// ------------------------------------------------------------------ monitor and reset
+
+class KamdDriverTest : public ::testing::Test
+{
+protected:
+    KamdParameters twoGroups(int nAtoms)
+    {
+        KamdParameters p;
+        p.groups         = { { 0 }, { 1 } };
+        p.groupNames     = { "a", "b" };
+        p.link           = { 0, 0 };
+        p.region         = { KamdRegion::Solution, KamdRegion::Solution };
+        p.temperature    = 300;
+        p.seed           = 42;
+        p.nzeroCrossings = 2;
+        p.pseudobdCycles = 10;
+        for (int i = 2; i < nAtoms; i++)
+        {
+            p.solvent.push_back(i);
+        }
+        p.logFile = fileManager_.getTemporaryFilePath("kamd.log").string();
+        return p;
+    }
+    TestFileManager fileManager_;
+};
+
+TEST_F(KamdDriverTest, CheckStepsFollowPmemd)
+{
+    Kamd kamd(twoGroups(3), 3, 0.002, nullptr);
+    EXPECT_FALSE(kamd.isCheckStep(0));
+    EXPECT_TRUE(kamd.isCheckStep(9)); // (stepRel + 1) % pseudobd-cycles == 0
+    EXPECT_FALSE(kamd.isCheckStep(10));
+    EXPECT_TRUE(kamd.isCheckStep(19));
+}
+
+TEST_F(KamdDriverTest, FiresAfterTheZeroCrossingBudget)
+{
+    Kamd                    kamd(twoGroups(3), 3, 0.002, nullptr);
+    const std::vector<real> mass = { 1, 1, 1 };
+    // group a ahead of / behind the common COM motion along x, alternately
+    const std::vector<RVec> ahead  = { { 2, 0, 0 }, { 0, 0, 0 }, { 0, 0, 0 } };
+    const std::vector<RVec> behind = { { 0, 0, 0 }, { 2, 0, 0 }, { 0, 0, 0 } };
+    EXPECT_FALSE(kamd.checkMomenta(0, {}, mass, ahead));  // first check: no previous sign
+    EXPECT_FALSE(kamd.checkMomenta(1, {}, mass, behind)); // crossing 1
+    EXPECT_FALSE(kamd.checkMomenta(2, {}, mass, behind)); // same sign
+    EXPECT_TRUE(kamd.checkMomenta(3, {}, mass, ahead));   // crossing 2 for both groups
+}
+
+//! Run one reset on a random system and return v(t) = v(t-dt/2) + F dt / 2m.
+std::vector<RVec> resetAndGetFullStepVelocities(Kamd&                    kamd,
+                                                const std::vector<RVec>& x,
+                                                const std::vector<RVec>& f,
+                                                const std::vector<real>& m,
+                                                const matrix             box,
+                                                int64_t                  step,
+                                                const std::vector<int>&  localToGlobal = {})
+{
+    std::vector<RVec> v(x.size(), RVec{ 0, 0, 0 });
+    kamd.resetVelocities(step, localToGlobal, m, x, f, box, v);
+    for (size_t i = 0; i < v.size(); i++)
+    {
+        for (int d = 0; d < 3; d++)
+        {
+            v[i][d] += f[i][d] * 0.001 / m[i];
+        }
+    }
+    return v;
+}
+
+TEST_F(KamdDriverTest, ResetRedirectsShellAndSurfaceAtomsAlongOneDirectionPerGroup)
+{
+    const matrix box             = { { 3.1, 0, 0 }, { 0, 2.9, 0 }, { 0, 0, 3.3 } };
+    auto         s               = makeRandomSystem(box, 7, false);
+    s.p.logFile                  = fileManager_.getTemporaryFilePath("kamd.log").string();
+    s.p.groupNames               = { "a", "b" };
+    const int                  n = static_cast<int>(s.x.size());
+    std::mt19937               gen(3);
+    std::normal_distribution<> nd(0, 300);
+    std::vector<RVec>          f(n);
+    std::vector<real>          m(n);
+    for (int i = 0; i < n; i++)
+    {
+        f[i] = { real(nd(gen)), real(nd(gen)), real(nd(gen)) };
+        m[i] = (i % 3 == 0) ? 16.0 : 1.008;
+    }
+    const auto record = kamdFindFirstShell(s.p, s.x, box);
+    Kamd       kamd(s.p, n, 0.002, nullptr);
+    const auto vfull = resetAndGetFullStepVelocities(kamd, s.x, f, m, box, 100);
+
+    for (int g = 0; g < 2; g++)
+    {
+        RVec dir{ 0, 0, 0 };
+        int  count = 0;
+        for (int i = 0; i < n; i++)
+        {
+            if (std::abs(record[i]) != g + 1)
+            {
+                continue;
+            }
+            RVec u = vfull[i];
+            u /= norm(u);
+            if (count == 0)
+            {
+                dir = u;
+            }
+            EXPECT_NEAR(iprod(u, dir), 1.0, 1e-4) << "atom " << i << " group " << g;
+            count++;
+        }
+        EXPECT_GT(count, 1);
+    }
+    EXPECT_EQ(kamd.numResets(), 1);
+}
+
+TEST_F(KamdDriverTest, ResetIsReproducibleAndIndependentOfAtomOrder)
+{
+    const matrix box    = { { 3.1, 0, 0 }, { 0, 2.9, 0 }, { 0, 0, 3.3 } };
+    auto         s      = makeRandomSystem(box, 8, false);
+    s.p.logFile         = fileManager_.getTemporaryFilePath("kamd.log").string();
+    s.p.groupNames      = { "a", "b" };
+    const int         n = static_cast<int>(s.x.size());
+    std::vector<RVec> f(n, RVec{ 10, -20, 5 });
+    std::vector<real> m(n, 12.0);
+
+    Kamd       k1(s.p, n, 0.002, nullptr);
+    Kamd       k2(s.p, n, 0.002, nullptr);
+    const auto a            = resetAndGetFullStepVelocities(k1, s.x, f, m, box, 500);
+    const auto b            = resetAndGetFullStepVelocities(k2, s.x, f, m, box, 500);
+    const auto c            = resetAndGetFullStepVelocities(k2, s.x, f, m, box, 501);
+    double     diffSameStep = 0, diffOtherStep = 0;
+    for (int i = 0; i < n; i++)
+    {
+        diffSameStep += norm2(RVec(a[i] - b[i]));
+        diffOtherStep += norm2(RVec(a[i] - c[i]));
+    }
+    EXPECT_EQ(diffSameStep, 0);
+    EXPECT_GT(diffOtherStep, 0);
+
+    // the same atoms stored in reversed local order (as with DD atom sorting) give the same result
+    std::vector<int>  l2g(n);
+    std::vector<RVec> xr(n), fr(n);
+    std::vector<real> mr(n);
+    for (int l = 0; l < n; l++)
+    {
+        l2g[l] = n - 1 - l;
+        xr[l]  = s.x[l2g[l]];
+        fr[l]  = f[l2g[l]];
+        mr[l]  = m[l2g[l]];
+    }
+    Kamd       k3(s.p, n, 0.002, nullptr);
+    const auto r = resetAndGetFullStepVelocities(k3, xr, fr, mr, box, 500, l2g);
+    for (int l = 0; l < n; l++)
+    {
+        for (int d = 0; d < 3; d++)
+        {
+            EXPECT_NEAR(r[l][d], a[l2g[l]][d], 1e-4);
+        }
+    }
+}
+
+TEST_F(KamdDriverTest, TransmembraneRedirectKeepsTheNormalComponent)
+{
+    const matrix box    = { { 3.1, 0, 0 }, { 0, 2.9, 0 }, { 0, 0, 3.3 } };
+    auto         s      = makeRandomSystem(box, 9, true);
+    s.p.logFile         = fileManager_.getTemporaryFilePath("kamd.log").string();
+    s.p.groupNames      = { "a", "b" };
+    const int         n = static_cast<int>(s.x.size());
+    std::vector<RVec> f(n, RVec{ 0, 0, 0 });
+    std::vector<real> m(n, 12.0);
+    const auto        record = kamdFindFirstShell(s.p, s.x, box);
+    Kamd              kamd(s.p, n, 0.002, nullptr);
+    const auto        v = resetAndGetFullStepVelocities(kamd, s.x, f, m, box, 3);
+    // all TM-flagged atoms share one in-plane direction; their z components are not redirected
+    RVec dir{ 0, 0, 0 };
+    int  count = 0;
+    for (int i = 0; i < n; i++)
+    {
+        if (std::abs(record[i]) != 2)
+        {
+            continue;
+        }
+        RVec inPlane{ v[i][0], v[i][1], 0 };
+        inPlane /= norm(inPlane);
+        if (count++ == 0)
+        {
+            dir = inPlane;
+        }
+        EXPECT_NEAR(iprod(inPlane, dir), 1.0, 1e-4);
+    }
+    EXPECT_GT(count, 1);
+}
