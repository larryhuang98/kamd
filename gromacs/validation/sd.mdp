integrator      = sd
dt              = 0.002
nsteps          = 250000
tc-grps         = System
tau-t           = 0.2
ref-t           = 355
ld-seed         = 1060
pcoupl          = C-rescale
tau-p           = 2.0
ref-p           = 1.0
compressibility = 4.5e-5
continuation    = yes
gen-vel         = no
constraints     = h-bonds
constraint-algorithm = lincs
cutoff-scheme   = Verlet
coulombtype     = PME
rcoulomb        = 0.8
rvdw            = 0.8
fourier-spacing = 0.105
DispCorr        = EnerPres
nstcomm         = 1000
nstcalcenergy   = 100
nstenergy       = 2500
nstlog          = 2500
nstxout-compressed = 0
