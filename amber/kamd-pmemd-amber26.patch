 !*******************************************************************************
 !
+! Subroutine:  read_kamd_namelist
+!
+! Description: Read the optional &kamd namelist.  Defaults are set in
+!              init_mdin_ctrl_dat before this is called; absent namelist =>
+!              KAMD stays disabled (pseudobd_cycles = 0).  Performs only the
+!              cheap, prmtop-independent validation here; mask resolution and
+!              atom-list construction happen later in resolve_kamd_masks.
+!
+!*******************************************************************************
+subroutine read_kamd_namelist()
+
+  use file_io_mod
+  use gbl_constants_mod, only : error_hdr
+  use parallel_dat_mod
+  use pmemd_lib_mod
+
+  implicit none
+
+  integer :: ifind
+  integer :: g
+
+  namelist /kamd/ pseudobd_cycles, nzero_crossings, &
+                  shell_cut, surface_cut, membrane_cut, &
+                  kamd_shell_mode, kamd_shell_relax_steps, &
+                  kamd_shell_max_angle, kamd_shell_area_floor, kamd_shell_area_reference, &
+                  refer_link, region_type, &
+                  refer_mask, solvent_mask, membrane_mask, &
+                  membrane_axis, &
+                  ion_mask, ion_traj_outfreq, ion_traj_file
+
+  rewind(mdin)
+  call nmlsrc('kamd', mdin, ifind)
+  if (ifind == 0) return            ! KAMD not requested; defaults stand
+
+  read(mdin, nml = kamd)
+
+  if (kamd_shell_mode < 0 .or. kamd_shell_mode > 1) then
+    write(mdout, '(a,a)') error_hdr, '&kamd: kamd_shell_mode must be 0 or 1'
+    call mexit(6, 1)
+  end if
+  if (kamd_shell_relax_steps < 0 .or. kamd_shell_max_angle <= 0.0d0 .or. &
+      kamd_shell_max_angle > 180.0d0 .or. kamd_shell_area_floor < 0.0d0 .or. &
+      kamd_shell_area_floor >= 1.0d0 .or. kamd_shell_area_reference < 0.0d0) then
+    write(mdout, '(a,a)') error_hdr, '&kamd: invalid membrane shell relaxation/angle/area setting'
+    call mexit(6, 1)
+  end if
+
+  ! Ion-trajectory validation (independent of pseudobd_cycles).
+  if (ion_traj_outfreq < 0) then
+    write(mdout, '(a,a)') error_hdr, '&kamd: ion_traj_outfreq must be >= 0'
+    call mexit(6, 1)
+  end if
+  if (ion_traj_outfreq > 0 .and. len_trim(ion_mask) == 0) then
+    write(mdout, '(a,a)') error_hdr, '&kamd: ion_mask is required when ion_traj_outfreq > 0'
+    call mexit(6, 1)
+  end if
+
+#if !defined(CUDA) || defined(MPI)
+  ! The KAMD code in runmd is CUDA-only and has been validated on a single GPU only.
+  ! Refuse instead of silently running plain MD (CPU pmemd) or an untested multi-GPU path.
+  if (pseudobd_cycles > 0 .or. ion_traj_outfreq > 0) then
+    write(mdout, '(a,a)') error_hdr, &
+      '&kamd: KAMD is available only in single-GPU pmemd.cuda (pmemd.cuda_SPFP / pmemd.cuda_DPFP)'
+    call mexit(6, 1)
+  end if
+#endif
+
+  if (pseudobd_cycles <= 0) return  ! Namelist present but disabled; nothing to validate
+
+  if (nzero_crossings <= 0) then
+    write(mdout, '(a,a)') error_hdr, '&kamd: nzero_crossings must be > 0'
+    call mexit(6, 1)
+  end if
+  if (shell_cut <= 0.0d0 .or. surface_cut <= 0.0d0) then
+    write(mdout, '(a,a)') error_hdr, '&kamd: shell_cut and surface_cut must be > 0'
+    call mexit(6, 1)
+  end if
+  if (surface_cut > shell_cut) then
+    write(mdout, '(a,a)') error_hdr, '&kamd: surface_cut must be <= shell_cut'
+    call mexit(6, 1)
+  end if
+  if (len_trim(solvent_mask) == 0) then
+    write(mdout, '(a,a)') error_hdr, '&kamd: solvent_mask is required when pseudobd_cycles > 0'
+    call mexit(6, 1)
+  end if
+
+  ! Count active groups and validate refer_link entries.
+  kamd_ngroups = 0
+  do g = 1, KAMD_MAX_GROUPS
+    if (len_trim(refer_mask(g)) > 0) kamd_ngroups = kamd_ngroups + 1
+  end do
+  if (kamd_ngroups == 0) then
+    write(mdout, '(a,a)') error_hdr, '&kamd: at least one refer_mask(i) must be set'
+    call mexit(6, 1)
+  end if
+
+  ! refer_mask entries must be packed into 1..kamd_ngroups (no gaps), so the
+  ! group index seen on the GPU side matches the position in the user input.
+  do g = 1, kamd_ngroups
+    if (len_trim(refer_mask(g)) == 0) then
+      write(mdout, '(a,a,i0,a)') error_hdr, &
+          '&kamd: refer_mask entries must be packed; refer_mask(', g, ') is empty'
+      call mexit(6, 1)
+    end if
+  end do
+  do g = kamd_ngroups + 1, KAMD_MAX_GROUPS
+    if (len_trim(refer_mask(g)) > 0) then
+      write(mdout, '(a,a)') error_hdr, &
+          '&kamd: refer_mask entries must be contiguous (no gaps)'
+      call mexit(6, 1)
+    end if
+  end do
+
+  do g = 1, kamd_ngroups
+    if (refer_link(g) < 0 .or. refer_link(g) > kamd_ngroups) then
+      write(mdout, '(a,a,i0,a,i0,a)') error_hdr, '&kamd: refer_link(', g, &
+          ') = ', refer_link(g), ' is out of range [0, kamd_ngroups]'
+      call mexit(6, 1)
+    end if
+    if (refer_link(g) == g) then
+      write(mdout, '(a,a,i0,a)') error_hdr, '&kamd: refer_link(', g, &
+          ') cannot reference its own group'
+      call mexit(6, 1)
+    end if
+  end do
+
+  ! Validate region_type and membrane setup.  region_type defaults to 1
+  ! (solution) for every group; transmembrane groups (type 2) require the
+  ! membrane bath to be specified.
+  do g = 1, kamd_ngroups
+    if (region_type(g) /= KAMD_RT_SOLUTION .and. region_type(g) /= KAMD_RT_TRANSMEMBRANE) then
+      write(mdout, '(a,a,i0,a,i0,a)') error_hdr, '&kamd: region_type(', g, &
+          ') = ', region_type(g), ' is invalid (1=solution, 2=transmembrane)'
+      call mexit(6, 1)
+    end if
+  end do
+  if (any(region_type(1:kamd_ngroups) == KAMD_RT_TRANSMEMBRANE)) then
+    if (len_trim(membrane_mask) == 0) then
+      write(mdout, '(a,a)') error_hdr, &
+          '&kamd: membrane_mask is required when any region_type == 2'
+      call mexit(6, 1)
+    end if
+    if (membrane_axis < 1 .or. membrane_axis > 3) then
+      write(mdout, '(a,a,i0,a)') error_hdr, &
+          '&kamd: membrane_axis = ', membrane_axis, ' is invalid (1=x, 2=y, 3=z)'
+      call mexit(6, 1)
+    end if
+    if (membrane_cut <= 0.0d0) then
+      write(mdout, '(a,a)') error_hdr, '&kamd: membrane_cut must be > 0'
+      call mexit(6, 1)
+    end if
+  end if
+  if (kamd_shell_mode == 1 .and. &
+      .not. any(region_type(1:kamd_ngroups) == KAMD_RT_TRANSMEMBRANE)) then
+    write(mdout, '(a,a)') error_hdr, '&kamd: kamd_shell_mode requires a transmembrane region'
+    call mexit(6, 1)
+  end if
+
+end subroutine read_kamd_namelist
+
+!*******************************************************************************
+!
+! Subroutine:  resolve_kamd_masks
+!
+! Description: Evaluate the &kamd refer_mask(:) and solvent_mask strings into
+!              concrete atom-index lists, using pmemd's existing AmberMask
+!              parser (findmask_mod::atommask).  Called once from master_setup
+!              after the prmtop and coordinates have been loaded.
+!
+!              Reference groups may resolve to discontiguous atom sets.
+!              The solvent mask must currently resolve to a single contiguous
+!              atom range (the GPU first-shell kernel uses a [start,end] range
+!              filter); we error out cleanly if it does not.
+!
+!*******************************************************************************
+subroutine resolve_kamd_masks(natom, nres, igraph, isymbl, ipres, lbres, crd)
+
+  use findmask_mod, only : atommask
+  use gbl_constants_mod, only : error_hdr
+  use parallel_dat_mod
+  use file_io_mod
+  use pmemd_lib_mod
+
+  implicit none
+
+  integer,           intent(in) :: natom, nres
+  integer,           intent(in) :: ipres(nres)
+  character(len=4),  intent(in) :: igraph(natom), isymbl(natom), lbres(nres)
+  double precision,  intent(in) :: crd(3*natom)
+
+  integer, allocatable :: scratch_mask(:)
+  integer, allocatable :: owner_mask(:)   ! per-atom claim tag for overlap detection
+  integer              :: g, a, idx, count_g
+  character(len=1024)  :: mask_buf
+
+  if (pseudobd_cycles <= 0 .and. ion_traj_outfreq <= 0) return  ! KAMD disabled: nothing to do
+
+  allocate(scratch_mask(natom))
+  allocate(owner_mask(natom))
+
+  ! Only resolve reference groups and solvent when pseudobd is active
+  if (pseudobd_cycles > 0) then
+    allocate(kamd_refer_count(kamd_ngroups))
+    allocate(kamd_refer_offset(kamd_ngroups))
+
+  ! Atom-claim tracker for overlap detection.
+  !   0           = unclaimed
+  !   1..ngroups  = claimed by refer_mask(g)
+  !   -1          = claimed by solvent_mask
+  ! Any double-claim is a hard error: a single atom cannot belong to two
+  ! reference groups, nor to both a reference group and the solvent bath.
+  owner_mask = 0
+
+  ! First pass: count atoms per group, sniff for refer/refer overlap.
+  kamd_total_ref_atoms = 0
+  do g = 1, kamd_ngroups
+    mask_buf = refer_mask(g)
+    call atommask(natom, nres, 0, igraph, isymbl, ipres, lbres, crd, mask_buf, scratch_mask)
+    count_g = sum(scratch_mask)
+    if (count_g <= 0) then
+      write(mdout, '(a,a,i0,a,a,a)') error_hdr, '&kamd: refer_mask(', g, &
+          ') = "', trim(refer_mask(g)), '" matched no atoms'
+      call mexit(6, 1)
+    end if
+    do a = 1, natom
+      if (scratch_mask(a) /= 0) then
+        if (owner_mask(a) > 0) then
+          write(mdout, '(a,a,i0,a,i0,a,i0,a)') error_hdr, &
+              '&kamd: atom ', a, ' is matched by both refer_mask(', &
+              owner_mask(a), ') and refer_mask(', g, '). Reference groups must not overlap.'
+          call mexit(6, 1)
+        end if
+        owner_mask(a) = g
+      end if
+    end do
+    kamd_refer_count(g)  = count_g
+    kamd_refer_offset(g) = kamd_total_ref_atoms
+    kamd_total_ref_atoms = kamd_total_ref_atoms + count_g
+  end do
+
+  ! Second pass: fill the flat (atom_idx, group_idx) lists.
+  allocate(kamd_refer_atoms(kamd_total_ref_atoms))
+  allocate(kamd_refer_groups(kamd_total_ref_atoms))
+  do g = 1, kamd_ngroups
+    mask_buf = refer_mask(g)
+    call atommask(natom, nres, 0, igraph, isymbl, ipres, lbres, crd, mask_buf, scratch_mask)
+    idx = kamd_refer_offset(g)
+    do a = 1, natom
+      if (scratch_mask(a) /= 0) then
+        idx = idx + 1
+        kamd_refer_atoms(idx)  = a
+        kamd_refer_groups(idx) = g
+      end if
+    end do
+    write(mdout, '(a,i0,a,a,a,i0,a)') '     KAMD refer_mask(', g, ') = "', &
+        trim(refer_mask(g)), '" matches ', kamd_refer_count(g), ' atoms'
+  end do
+
+  ! Solvent mask: must resolve to a contiguous range for the current GPU
+  ! kernel.  We accept any mask whose selected atoms span exactly one
+  ! contiguous block of indices.
+  mask_buf = solvent_mask
+  call atommask(natom, nres, 0, igraph, isymbl, ipres, lbres, crd, mask_buf, scratch_mask)
+  kamd_solvent_start = 0
+  kamd_solvent_end   = 0
+  do a = 1, natom
+    if (scratch_mask(a) /= 0) then
+      if (kamd_solvent_start == 0) kamd_solvent_start = a
+      kamd_solvent_end = a
+    end if
+  end do
+  if (kamd_solvent_start == 0) then
+    write(mdout, '(a,a,a,a)') error_hdr, '&kamd: solvent_mask = "', &
+        trim(solvent_mask), '" matched no atoms'
+    call mexit(6, 1)
+  end if
+  if (sum(scratch_mask) /= (kamd_solvent_end - kamd_solvent_start + 1)) then
+    write(mdout, '(a,a,a,a)') error_hdr, '&kamd: solvent_mask = "', &
+        trim(solvent_mask), '" must resolve to a contiguous atom range'
+    write(mdout, '(a,i0,a,i0,a,i0,a)') &
+        '     resolved span = [', kamd_solvent_start, ', ', kamd_solvent_end, &
+        '] but only ', sum(scratch_mask), ' atoms selected (gaps present).'
+    write(mdout, '(a)') &
+        '     Reorder solvent residues to be contiguous in the prmtop, or split into a separate run.'
+    call mexit(6, 1)
+  end if
+
+  ! refer/solvent overlap check: any atom claimed by a refer_mask cannot also
+  ! be in the solvent bath.
+  do a = kamd_solvent_start, kamd_solvent_end
+    if (scratch_mask(a) /= 0 .and. owner_mask(a) > 0) then
+      write(mdout, '(a,a,i0,a,i0,a)') error_hdr, &
+          '&kamd: atom ', a, ' is matched by both refer_mask(', &
+          owner_mask(a), ') and solvent_mask. Reference groups and the solvent bath must not overlap.'
+      call mexit(6, 1)
+    end if
+    ! Mark solvent atoms with sentinel -1 so the membrane pass below can detect
+    ! solvent/membrane overlap as well.
+    if (scratch_mask(a) /= 0) owner_mask(a) = -1
+  end do
+
+  write(mdout, '(a,a,a,i0,a,i0,a)') '     KAMD solvent_mask = "', &
+      trim(solvent_mask), '" -> contiguous range [', kamd_solvent_start, &
+      ', ', kamd_solvent_end, ']'
+
+    ! Membrane mask: required iff any region is transmembrane.  Same contiguous-
+  ! range constraint as solvent (kernel uses [start,end] filter), and no atom
+  ! may be claimed by both the membrane bath and any reference group or the
+  ! solvent bath.
+  if (any(region_type(1:kamd_ngroups) == KAMD_RT_TRANSMEMBRANE)) then
+    mask_buf = membrane_mask
+    call atommask(natom, nres, 0, igraph, isymbl, ipres, lbres, crd, mask_buf, scratch_mask)
+    kamd_membrane_start = 0
+    kamd_membrane_end   = 0
+    do a = 1, natom
+      if (scratch_mask(a) /= 0) then
+        if (kamd_membrane_start == 0) kamd_membrane_start = a
+        kamd_membrane_end = a
+      end if
+    end do
+    if (kamd_membrane_start == 0) then
+      write(mdout, '(a,a,a,a)') error_hdr, '&kamd: membrane_mask = "', &
+          trim(membrane_mask), '" matched no atoms'
+      call mexit(6, 1)
+    end if
+    if (sum(scratch_mask) /= (kamd_membrane_end - kamd_membrane_start + 1)) then
+      write(mdout, '(a,a,a,a)') error_hdr, '&kamd: membrane_mask = "', &
+          trim(membrane_mask), '" must resolve to a contiguous atom range'
+      write(mdout, '(a,i0,a,i0,a,i0,a)') &
+          '     resolved span = [', kamd_membrane_start, ', ', kamd_membrane_end, &
+          '] but only ', sum(scratch_mask), ' atoms selected (gaps present).'
+      call mexit(6, 1)
+    end if
+    do a = kamd_membrane_start, kamd_membrane_end
+      if (scratch_mask(a) /= 0 .and. owner_mask(a) > 0) then
+        write(mdout, '(a,a,i0,a,i0,a)') error_hdr, &
+            '&kamd: atom ', a, ' is matched by both refer_mask(', &
+            owner_mask(a), ') and membrane_mask. Reference groups and the membrane bath must not overlap.'
+        call mexit(6, 1)
+      end if
+      if (scratch_mask(a) /= 0 .and. owner_mask(a) == -1) then
+        write(mdout, '(a,a,i0,a)') error_hdr, &
+            '&kamd: atom ', a, ' is matched by both solvent_mask and membrane_mask. The two baths must be disjoint.'
+        call mexit(6, 1)
+      end if
+    end do
+    write(mdout, '(a,a,a,i0,a,i0,a)') '     KAMD membrane_mask = "', &
+        trim(membrane_mask), '" -> contiguous range [', kamd_membrane_start, &
+        ', ', kamd_membrane_end, ']'
+  end if
+
+  end if
+
+  ! ----- Ion-trajectory setup (independent of pseudobd_cycles) -----
+  if (ion_traj_outfreq > 0) then
+
+    ! Resolve ion_mask -> kamd_ion_atoms (1-based).
+    mask_buf = ion_mask
+    call atommask(natom, nres, 0, igraph, isymbl, ipres, lbres, crd, mask_buf, scratch_mask)
+    kamd_nions = sum(scratch_mask)
+    if (kamd_nions <= 0) then
+      write(mdout, '(a,a,a,a)') error_hdr, '&kamd: ion_mask = "', trim(ion_mask), '" matched no atoms'
+      call mexit(6, 1)
+    end if
+    allocate(kamd_ion_atoms(kamd_nions))
+    allocate(kamd_ion_xyz(3, kamd_nions))
+    idx = 0
+    do a = 1, natom
+      if (scratch_mask(a) /= 0) then
+        idx = idx + 1
+        kamd_ion_atoms(idx) = a
+      end if
+    end do
+    write(mdout, '(a,a,a,i0,a)') '     KAMD ion_mask = "', trim(ion_mask), '" matches ', kamd_nions, ' atoms'
+
+    ! Membrane COM reference is required for the ion-trajectory file.  If the TM
+    ! block above did not already resolve it, resolve membrane_mask here with the
+    ! same contiguous-range requirement (the COM reduction iterates [start,end]).
+    if (kamd_membrane_start == 0) then
+      mask_buf = membrane_mask
+      call atommask(natom, nres, 0, igraph, isymbl, ipres, lbres, crd, mask_buf, scratch_mask)
+      kamd_membrane_start = 0
+      kamd_membrane_end   = 0
+      do a = 1, natom
+        if (scratch_mask(a) /= 0) then
+          if (kamd_membrane_start == 0) kamd_membrane_start = a
+          kamd_membrane_end = a
+        end if
+      end do
+      if (kamd_membrane_start == 0) then
+        write(mdout, '(a,a)') error_hdr, '&kamd: membrane_mask is required for ion trajectory output (membrane COM)'
+        call mexit(6, 1)
+      end if
+      if (sum(scratch_mask) /= (kamd_membrane_end - kamd_membrane_start + 1)) then
+        write(mdout, '(a,a,a,a)') error_hdr, '&kamd: membrane_mask = "', trim(membrane_mask), '" must resolve to a contiguous atom range'
+        call mexit(6, 1)
+      end if
+      write(mdout, '(a,a,a,i0,a,i0,a)') '     KAMD membrane_mask (ion-traj COM) -> contiguous range [', &
+          kamd_membrane_start, ', ', kamd_membrane_end, ']'
+    end if
+
+  end if
+
+  deallocate(scratch_mask)
+  deallocate(owner_mask)
+
+end subroutine resolve_kamd_masks
+
+!*******************************************************************************
+!
 ! Subroutine:  validate_mdin_ctrl_dat
 !
 ! Description: <TBS>
diff --git a/src/pmemd/src/runmd.F90 b/src/pmemd/src/runmd.F90
index 482fbce..1cf6eb6 100644
--- a/src/pmemd/src/runmd.F90
+++ b/src/pmemd/src/runmd.F90
@@ -50,7 +50,7 @@ subroutine runmd(atm_cnt, crd, mass, frc, vel, last_vel)
   use extra_pnts_nb14_mod
   use gb_force_mod
   use gb_ene_mod
-  use gbl_constants_mod, only : KB
+  use gbl_constants_mod, only : KB, ONE_AMBER_ELECTROSTATIC
   use pbc_mod
   use pme_force_mod
   use file_io_mod
@@ -347,6 +347,23 @@ subroutine runmd(atm_cnt, crd, mass, frc, vel, last_vel)
 ! alchemical endstate reservoirs
   logical               :: resv_exchged
 
+  ! KAMD locals.  Per-group arrays use KAMD_MAX_GROUPS so that lifting the
+  ! GPU buffer cap later only requires changing the parameter.
+  double precision      :: tmp_vel(3, atm_cnt)
+  double precision      :: distance_record(atm_cnt)
+  double precision      :: tmp_crd(3, atm_cnt), tmp_frc(3, atm_cnt)
+  double precision      :: relative_dis(3), random_direction(3, KAMD_MAX_GROUPS)
+  double precision      :: moment(3, KAMD_MAX_GROUPS), moment_last(3, KAMD_MAX_GROUPS)
+  double precision      :: refer_mass(KAMD_MAX_GROUPS)
+  double precision      :: tmp_xmin, tmp_xmax, tmp_ymin, tmp_ymax, tmp_zmin, tmp_zmax
+  integer               :: tmp_mark(atm_cnt), tmp_record(atm_cnt)
+  integer               :: tmp_count(KAMD_MAX_GROUPS)
+  double precision      :: kamd_cut2, kamd_surface_cut2
+  integer               :: kamd_g, kamd_a, kamd_off, kamd_cnt
+  integer               :: kamd_shell_last_reset
+  double precision      :: kamd_shell_initial_area, kamd_shell_area
+  logical               :: kamd_shell_ready, kamd_shell_gate_logged
+
 ! Runmd operates in kcal/mol units for energy, amu for masses,
 ! and angstoms for distances.  To convert the input time parameters
 ! from picoseconds to internal units, multiply by 20.455
@@ -2110,6 +2127,469 @@ DBG_ARRAYS_TIME_STEP(nstep)
       strt_time_ms = dble(wall_s) * 1000.0d0 + dble(wall_u) / 1000.0d0
 #endif
 
+! KAMD (Kinetically Accelerated MD) — see doc/kamd/kamd_implementation.tex.
+! Current functionality in this block includes:
+!   - mask-resolved reference groups (kamd_refer_* lists)
+!   - optional linked group directions via refer_link(:)
+!   - mixed region handling (solution vs transmembrane via region_type(:))
+!   - distinct solvent/membrane baths and membrane-axis-aware TM redirects
+!   - optional one-shot CPU/GPU diagnostic dump via KAMD_DIAG=1
+#ifdef CUDA
+if (pseudobd_cycles > 0) then
+
+  ! ---- One-time setup at simulation start --------------------------------
+  if (total_nstep .eq. 0) then
+    moment       = 0.0d0
+    moment_last  = 0.0d0
+    tmp_count    = 0
+    refer_mass   = 0.0d0
+    kamd_shell_last_reset = -huge(1)/2
+    select case (membrane_axis)
+    case (1)
+      kamd_shell_initial_area = pbc_box(2) * pbc_box(3)
+    case (2)
+      kamd_shell_initial_area = pbc_box(1) * pbc_box(3)
+    case default
+      kamd_shell_initial_area = pbc_box(1) * pbc_box(2)
+    end select
+    if (kamd_shell_area_reference > 0.0d0) kamd_shell_initial_area = kamd_shell_area_reference
+    if (kamd_shell_mode == 1) then
+      write(mdout,'(a,f16.4)') ' KAMD shell: reference membrane area (A^2) = ', kamd_shell_initial_area
+    end if
+    kamd_shell_gate_logged = .false.
+    do kamd_g = 1, kamd_ngroups
+      kamd_off = kamd_refer_offset(kamd_g)
+      kamd_cnt = kamd_refer_count(kamd_g)
+      refer_mass(kamd_g) = sum(mass(kamd_refer_atoms(kamd_off+1 : kamd_off+kamd_cnt)))
+    end do
+
+    ! Upload the resolved (atom, group) lists, region types, bath ranges, and
+    ! cutoffs.  All of these are constants for the rest of the run.
+    call gpu_kamd_setup(kamd_refer_atoms, kamd_refer_groups, kamd_total_ref_atoms, &
+                        region_type, &
+                        kamd_solvent_start, kamd_solvent_end, &
+                        kamd_membrane_start, kamd_membrane_end, &
+                        membrane_axis, &
+                        shell_cut, surface_cut, membrane_cut, &
+                        kamd_ngroups, gbl_res_atms, nres, &
+                        kamd_shell_mode, kamd_shell_max_angle)
+  end if
+
+  ! ---- Per-cycle momentum monitoring -------------------------------------
+  if (mod((total_nstep+1), pseudobd_cycles) .eq. 0) then
+    call gpu_kamd_compute_momenta(moment)
+
+    relative_dis = sum(moment(:, 1:kamd_ngroups), dim=2) / sum(refer_mass(1:kamd_ngroups))
+
+    do kamd_g = 1, kamd_ngroups
+      moment(:, kamd_g) = moment(:, kamd_g) - refer_mass(kamd_g) * relative_dis
+      if (region_type(kamd_g) == KAMD_RT_TRANSMEMBRANE) moment(membrane_axis, kamd_g) = 0.0d0
+      moment(:, kamd_g) = dot_product(moment(:, kamd_g), relative_dis)
+      if (moment(1, kamd_g) * moment_last(1, kamd_g) < 0.0d0 .and. &
+          tmp_count(kamd_g) < nzero_crossings) then
+        tmp_count(kamd_g) = tmp_count(kamd_g) + 1
+      end if
+    end do
+    ! Inactive group slots stay at nzero_crossings so they don't gate the reset.
+    do kamd_g = kamd_ngroups + 1, KAMD_MAX_GROUPS
+      tmp_count(kamd_g) = nzero_crossings
+    end do
+    moment_last = moment
+  end if
+
+  ! ---- Pseudo-Brownian dynamics reset ------------------------------------
+  ! Trigger: every active group has used its zero-crossing budget.
+select case (membrane_axis)
+case (1)
+  kamd_shell_area = pbc_box(2) * pbc_box(3)
+case (2)
+  kamd_shell_area = pbc_box(1) * pbc_box(3)
+case default
+  kamd_shell_area = pbc_box(1) * pbc_box(2)
+end select
+kamd_shell_ready = .true.
+if (kamd_shell_mode == 1) then
+  kamd_shell_ready = total_nstep + 1 - kamd_shell_last_reset >= kamd_shell_relax_steps
+  if (kamd_shell_area_floor > 0.0d0) then
+    kamd_shell_ready = kamd_shell_ready .and. &
+      kamd_shell_area >= kamd_shell_area_floor * kamd_shell_initial_area
+  end if
+end if
+if (sum(tmp_count(1:kamd_ngroups)) .eq. nzero_crossings * kamd_ngroups .and. kamd_shell_ready) then
+  kamd_shell_gate_logged = .false.
+  write(mdout, '(a,i12)') ' KAMD_DBG RESET FIRED at nstep=', total_nstep+1
+  kamd_shell_last_reset = total_nstep + 1
+
+  moment       = 0.0d0
+  moment_last  = 0.0d0
+  tmp_count    = 0
+
+  ! Step 1: Resample all velocities from Maxwell-Boltzmann on the GPU.
+  call gpu_vrand_reset_velocities(temp0 * factt, half_dtx)
+
+  ! Step 2: Generate per-group random direction vectors (cheap; CPU side).
+  !         refer_link(g) > 0 means group g shares the direction of group refer_link(g).
+  call vrand_set_velocities(kamd_ngroups, random_direction, atm_mass_inv, temp0 * factt)
+  do kamd_g = 1, kamd_ngroups
+    if (refer_link(kamd_g) > 0) then
+      random_direction(:, kamd_g) = random_direction(:, refer_link(kamd_g))
+    end if
+  end do
+
+  ! Transmembrane regions: project out the membrane-axis component and renormalize
+  ! the remaining 2D vector in the perpendicular plane.  The GPU redirect kernel
+  ! preserves v_par along membrane_axis and randomizes the perp components only.
+  do kamd_g = 1, kamd_ngroups
+    if (region_type(kamd_g) == KAMD_RT_TRANSMEMBRANE) then
+      random_direction(membrane_axis, kamd_g) = 0.0d0
+      wfac = sqrt(dot_product(random_direction(:, kamd_g), random_direction(:, kamd_g)))
+      if (wfac > 1.0d-10) then
+        random_direction(:, kamd_g) = random_direction(:, kamd_g) / wfac
+      else
+        ! Pathological: the sampled vector was (essentially) along membrane_axis.
+        ! Fall back to a fixed perpendicular direction; rare enough to be benign.
+        random_direction(:, kamd_g) = 0.0d0
+        if (membrane_axis == 1) then
+          random_direction(2, kamd_g) = 1.0d0
+        else
+          random_direction(1, kamd_g) = 1.0d0
+        end if
+      end if
+    end if
+  end do
+
+  kamd_cut2         = shell_cut   * shell_cut
+  kamd_surface_cut2 = surface_cut * surface_cut
+
+  ! =========================================================================
+  ! DIAGNOSTIC: at the first KAMD reset, run a brute-force CPU first-shell
+  ! loop on the exact same downloaded state, then run the GPU kernel as usual,
+  ! then dump both result sets and exit.  Activated by env KAMD_DIAG=1.
+  !
+  ! NB: bounding-box prefilter assumes an orthogonal box.  The CPU reference
+  ! mirrors the original Haixin algorithm (same min-image, same surface mark),
+  ! generalised to iterate the resolved per-group atom lists rather than
+  ! contiguous start..end ranges.
+  ! =========================================================================
+  block
+    character(len=32) :: diag_env
+    integer :: diag_unit_cpu, diag_unit_gpu, diag_i, diag_j, diag_jj, diag_g
+    integer :: gpu_record_buf(atm_cnt), gpu_group_buf(atm_cnt)
+    double precision :: gpu_r2_buf(atm_cnt)
+    logical, save :: diag_done = .false.
+    call get_environment_variable('KAMD_DIAG', diag_env)
+    if ((trim(diag_env) == '1') .and. (.not. diag_done)) then
+      diag_done = .true.
+      write(mdout,'(a,i10)') ' KAMD-DIAG: first-reset diagnostic at step ', total_nstep + 1
+
+      ! Pull the state the GPU kernel will see.  pImageVel was just set by
+      ! gpu_vrand_reset_velocities; pImageX is the current coords; forces are
+      ! the ones from the last force calc on this step.
+      call gpu_download_crd(tmp_crd)
+      call wrap_molecules(tmp_crd)
+      call gpu_download_vel(tmp_vel)
+      call gpu_download_frc(tmp_frc)
+
+      ! --- CPU reference first-shell algorithm over kamd_ngroups groups ---
+      distance_record = kamd_cut2
+      tmp_record      = 0
+      do diag_g = 1, kamd_ngroups
+        kamd_off = kamd_refer_offset(diag_g)
+        kamd_cnt = kamd_refer_count(diag_g)
+        diag_j = kamd_refer_atoms(kamd_off + 1)
+        tmp_xmin = tmp_crd(1, diag_j); tmp_xmax = tmp_xmin
+        tmp_ymin = tmp_crd(2, diag_j); tmp_ymax = tmp_ymin
+        tmp_zmin = tmp_crd(3, diag_j); tmp_zmax = tmp_zmin
+        do diag_jj = 1, kamd_cnt
+          diag_j = kamd_refer_atoms(kamd_off + diag_jj)
+          if (tmp_crd(1,diag_j) < tmp_xmin) tmp_xmin = tmp_crd(1,diag_j)
+          if (tmp_crd(2,diag_j) < tmp_ymin) tmp_ymin = tmp_crd(2,diag_j)
+          if (tmp_crd(3,diag_j) < tmp_zmin) tmp_zmin = tmp_crd(3,diag_j)
+          if (tmp_crd(1,diag_j) > tmp_xmax) tmp_xmax = tmp_crd(1,diag_j)
+          if (tmp_crd(2,diag_j) > tmp_ymax) tmp_ymax = tmp_crd(2,diag_j)
+          if (tmp_crd(3,diag_j) > tmp_zmax) tmp_zmax = tmp_crd(3,diag_j)
+        end do
+        tmp_xmin = tmp_xmin - shell_cut
+        tmp_ymin = tmp_ymin - shell_cut
+        tmp_zmin = tmp_zmin - shell_cut
+        tmp_xmax = tmp_xmax + shell_cut
+        tmp_ymax = tmp_ymax + shell_cut
+        tmp_zmax = tmp_zmax + shell_cut
+        tmp_mark = 0
+        do diag_j = kamd_solvent_start, kamd_solvent_end
+          if ((tmp_crd(1,diag_j) > tmp_xmin .and. tmp_crd(1,diag_j) < tmp_xmax) .or. &
+              (tmp_crd(1,diag_j) > tmp_xmin+pbc_box(1) .and. tmp_crd(1,diag_j) < tmp_xmax+pbc_box(1)) .or. &
+              (tmp_crd(1,diag_j) > tmp_xmin-pbc_box(1) .and. tmp_crd(1,diag_j) < tmp_xmax-pbc_box(1))) then
+          if ((tmp_crd(2,diag_j) > tmp_ymin .and. tmp_crd(2,diag_j) < tmp_ymax) .or. &
+              (tmp_crd(2,diag_j) > tmp_ymin+pbc_box(2) .and. tmp_crd(2,diag_j) < tmp_ymax+pbc_box(2)) .or. &
+              (tmp_crd(2,diag_j) > tmp_ymin-pbc_box(2) .and. tmp_crd(2,diag_j) < tmp_ymax-pbc_box(2))) then
+          if ((tmp_crd(3,diag_j) > tmp_zmin .and. tmp_crd(3,diag_j) < tmp_zmax) .or. &
+              (tmp_crd(3,diag_j) > tmp_zmin+pbc_box(3) .and. tmp_crd(3,diag_j) < tmp_zmax+pbc_box(3)) .or. &
+              (tmp_crd(3,diag_j) > tmp_zmin-pbc_box(3) .and. tmp_crd(3,diag_j) < tmp_zmax-pbc_box(3))) then
+            tmp_mark(diag_j) = 1
+          end if
+          end if
+          end if
+        end do
+        do diag_jj = 1, kamd_cnt
+          diag_j = kamd_refer_atoms(kamd_off + diag_jj)
+          do diag_i = kamd_solvent_start, kamd_solvent_end
+            if (tmp_mark(diag_i) .eq. 1) then
+              relative_dis(1) = min(abs(tmp_crd(1,diag_j)-tmp_crd(1,diag_i)), &
+                                    pbc_box(1)-abs(tmp_crd(1,diag_j)-tmp_crd(1,diag_i)))
+              relative_dis(2) = min(abs(tmp_crd(2,diag_j)-tmp_crd(2,diag_i)), &
+                                    pbc_box(2)-abs(tmp_crd(2,diag_j)-tmp_crd(2,diag_i)))
+              relative_dis(3) = min(abs(tmp_crd(3,diag_j)-tmp_crd(3,diag_i)), &
+                                    pbc_box(3)-abs(tmp_crd(3,diag_j)-tmp_crd(3,diag_i)))
+              scaltp = dot_product(relative_dis, relative_dis)
+              if (scaltp < kamd_surface_cut2) tmp_record(diag_j) = 1
+              if (scaltp < distance_record(diag_i)) then
+                tmp_record(diag_i)      = diag_g
+                distance_record(diag_i) = scaltp
+              end if
+            end if
+          end do
+        end do
+      end do
+
+      ! --- Dump CPU-side records ---
+      open(newunit=diag_unit_cpu, file='kamd_diag_cpu.txt', status='replace', action='write')
+      write(diag_unit_cpu,'(a)') '# atom_index(1-based) tmp_record distance_record_r2(double)'
+      do diag_i = 1, atm_cnt
+        if (tmp_record(diag_i) /= 0) then
+          write(diag_unit_cpu,'(i10,1x,i4,1x,es23.16)') diag_i, tmp_record(diag_i), distance_record(diag_i)
+        end if
+      end do
+      close(diag_unit_cpu)
+
+      ! --- Apply CPU reference redirect on the snapshot and save the expected vels ---
+      ! tmp_vel is currently the half-step velocity right after gpu_vrand_reset_velocities.
+      ! Apply the leapfrog half-step force correction, redirect, step back.
+      block
+        integer :: diag_k
+        double precision :: cpu_vel_expected(3, atm_cnt)
+        double precision :: diag_norm
+        double precision :: diag_dir(3, KAMD_MAX_GROUPS)
+
+        cpu_vel_expected = tmp_vel
+        do diag_k = 1, atm_cnt
+          wfac = atm_mass_inv(diag_k) * half_dtx
+          cpu_vel_expected(:, diag_k) = cpu_vel_expected(:, diag_k) + tmp_frc(:, diag_k) * wfac
+        end do
+
+        ! Pre-normalize per-group direction vectors.
+        diag_dir = 0.0d0
+        do diag_g = 1, kamd_ngroups
+          diag_norm = sqrt(dot_product(random_direction(:, diag_g), random_direction(:, diag_g)))
+          if (diag_norm > 0.0d0) diag_dir(:, diag_g) = random_direction(:, diag_g) / diag_norm
+        end do
+
+        ! Redirect solvent atoms assigned to a group.
+        do diag_i = kamd_solvent_start, kamd_solvent_end
+          diag_g = tmp_record(diag_i)
+          if (diag_g >= 1 .and. diag_g <= kamd_ngroups) then
+            wfac = sqrt(dot_product(cpu_vel_expected(:,diag_i), cpu_vel_expected(:,diag_i)))
+            cpu_vel_expected(:, diag_i) = diag_dir(:, diag_g) * wfac
+          end if
+        end do
+        ! Redirect surface ref atoms (tmp_record==1 inside each group's atom list).
+        do diag_g = 1, kamd_ngroups
+          kamd_off = kamd_refer_offset(diag_g)
+          kamd_cnt = kamd_refer_count(diag_g)
+          do diag_jj = 1, kamd_cnt
+            diag_i = kamd_refer_atoms(kamd_off + diag_jj)
+            if (tmp_record(diag_i) .eq. 1) then
+              wfac = sqrt(dot_product(cpu_vel_expected(:,diag_i), cpu_vel_expected(:,diag_i)))
+              cpu_vel_expected(:, diag_i) = diag_dir(:, diag_g) * wfac
+            end if
+          end do
+        end do
+        ! Final back-step for leapfrog.
+        do diag_k = 1, atm_cnt
+          wfac = atm_mass_inv(diag_k) * half_dtx
+          cpu_vel_expected(:, diag_k) = cpu_vel_expected(:, diag_k) - tmp_frc(:, diag_k) * wfac
+        end do
+
+        ! --- Run the GPU kernel and pull back the resulting velocities ---
+        call gpu_kamd_pseudobd_reset(random_direction, kamd_ngroups, half_dtx)
+        gpu_record_buf = 0
+        gpu_group_buf  = 0
+        gpu_r2_buf     = kamd_cut2
+        call gpu_kamd_download_record(gpu_record_buf, atm_cnt)
+        call gpu_kamd_download_packed(gpu_r2_buf, gpu_group_buf, atm_cnt)
+        ! reuse tmp_vel to read the post-kernel velocities
+        call gpu_download_vel(tmp_vel)
+
+        ! --- Dump velocity-diff for flagged atoms ---
+        block
+          integer :: diag_unit_v
+          double precision :: dx, dy, dz, rel, maxrel
+          integer :: nmis_exact, nflagged
+          maxrel = 0.0d0
+          nmis_exact = 0
+          nflagged = 0
+          open(newunit=diag_unit_v, file='kamd_diag_vel.txt', status='replace', action='write')
+          write(diag_unit_v,'(a)') '# atom group cpu_vx cpu_vy cpu_vz gpu_vx gpu_vy gpu_vz relerr'
+          do diag_i = 1, atm_cnt
+            if (tmp_record(diag_i) /= 0) then
+              nflagged = nflagged + 1
+              dx = tmp_vel(1,diag_i) - cpu_vel_expected(1,diag_i)
+              dy = tmp_vel(2,diag_i) - cpu_vel_expected(2,diag_i)
+              dz = tmp_vel(3,diag_i) - cpu_vel_expected(3,diag_i)
+              rel = sqrt(dx*dx+dy*dy+dz*dz) / &
+                    max(1.0d-30, sqrt(dot_product(cpu_vel_expected(:,diag_i), cpu_vel_expected(:,diag_i))))
+              if (rel > maxrel) maxrel = rel
+              if (dx /= 0.0d0 .or. dy /= 0.0d0 .or. dz /= 0.0d0) nmis_exact = nmis_exact + 1
+              if (rel > 1.0d-14) then
+                write(diag_unit_v,'(i10,1x,i4,6(1x,es23.16),1x,es12.5)') diag_i, tmp_record(diag_i), &
+                    cpu_vel_expected(1,diag_i), cpu_vel_expected(2,diag_i), cpu_vel_expected(3,diag_i), &
+                    tmp_vel(1,diag_i), tmp_vel(2,diag_i), tmp_vel(3,diag_i), rel
+              end if
+            end if
+          end do
+          close(diag_unit_v)
+          write(mdout,'(a,i0,a,i0,a,es12.5)') &
+              ' KAMD-DIAG: flagged=', nflagged, '  non-bit-identical=', nmis_exact, '  max_rel_err=', maxrel
+        end block
+        block
+          integer :: dump_unit, diag_nunflagged
+          double precision :: dxx, dyy, dzz, rr
+          double precision :: unflagged_max, unflagged_mean
+          integer :: n_unf
+          open(newunit=dump_unit, file='kamd_diag_vel_all.txt', status='replace', action='write')
+          write(dump_unit,'(a)') '# atom flagged cpu_vx cpu_vy cpu_vz gpu_vx gpu_vy gpu_vz'
+          unflagged_max = 0.0d0
+          unflagged_mean = 0.0d0
+          n_unf = 0
+          diag_nunflagged = 0
+          do diag_i = 1, atm_cnt
+            if (tmp_record(diag_i) == 0) then
+              diag_nunflagged = diag_nunflagged + 1
+              dxx = tmp_vel(1,diag_i) - cpu_vel_expected(1,diag_i)
+              dyy = tmp_vel(2,diag_i) - cpu_vel_expected(2,diag_i)
+              dzz = tmp_vel(3,diag_i) - cpu_vel_expected(3,diag_i)
+              rr = sqrt(dxx*dxx+dyy*dyy+dzz*dzz)
+              if (rr /= 0.0d0) then
+                n_unf = n_unf + 1
+                unflagged_mean = unflagged_mean + rr
+                if (rr > unflagged_max) unflagged_max = rr
+              end if
+            end if
+          end do
+          close(dump_unit)
+          if (diag_nunflagged > 0) unflagged_mean = unflagged_mean / diag_nunflagged
+          write(mdout,'(a,i0,a,i0)')  ' KAMD-DIAG: unflagged=', diag_nunflagged, '  unflagged-vel-differing=', n_unf
+          write(mdout,'(a,es12.5,a,es12.5)') ' KAMD-DIAG: unflagged max vel diff=', unflagged_max, &
+                                            '  mean vel diff=', unflagged_mean
+        end block
+      end block
+
+      open(newunit=diag_unit_gpu, file='kamd_diag_gpu.txt', status='replace', action='write')
+      write(diag_unit_gpu,'(a)') '# atom_index(1-based) pRecord packed_group packed_r2_f32(decoded)'
+      do diag_i = 1, atm_cnt
+        if (gpu_record_buf(diag_i) /= 0 .or. gpu_group_buf(diag_i) /= 0) then
+          write(diag_unit_gpu,'(i10,1x,i4,1x,i4,1x,es23.16)') &
+              diag_i, gpu_record_buf(diag_i), gpu_group_buf(diag_i), gpu_r2_buf(diag_i)
+        end if
+      end do
+      close(diag_unit_gpu)
+
+      write(mdout,'(a)') ' KAMD-DIAG: wrote kamd_diag_cpu.txt and kamd_diag_gpu.txt'
+      write(mdout,'(a)') ' KAMD-DIAG: exiting cleanly'
+      call mexit(6, 0)
+    end if
+  end block
+
+  ! Step 4: Single GPU call does everything:
+  !   - First-shell detection using cell decomposition (no crd download)
+  !   - Velocity redirection with half-step force correction (no vel download/upload)
+  call gpu_kamd_pseudobd_reset(random_direction, kamd_ngroups, half_dtx)
+
+  do kamd_g = 1, kamd_ngroups
+    write(mdout,'(a,i0,a,i10)') ' KAMD: velocity reset, group ', kamd_g, &
+        ', step ', total_nstep + 1
+  end do
+
+  reset_velocities = .true.
+
+end if
+! Only report the area safety gate. The ordinary relaxation interval also
+! defers a reset, but is expected between consecutive shell resets.
+if (kamd_shell_mode == 1 .and. kamd_shell_area_floor > 0.0d0 .and. &
+    kamd_shell_area < kamd_shell_area_floor * kamd_shell_initial_area .and. &
+    sum(tmp_count(1:kamd_ngroups)) .eq. nzero_crossings * kamd_ngroups) then
+  if (.not. kamd_shell_gate_logged) then
+    write(mdout,'(a,i0,a,f8.4,a,f8.4)') ' KAMD shell: reset blocked by area floor at step ', &
+      total_nstep + 1, ', area ratio=', kamd_shell_area / kamd_shell_initial_area, &
+      ', floor=', kamd_shell_area_floor
+    kamd_shell_gate_logged = .true.
+  end if
+end if
+end if
+#endif
+
+! ===== KAMD ion-trajectory output (independent of pseudobd_cycles) =====
+#ifdef CUDA
+  if (ion_traj_outfreq > 0) then
+    block
+      integer :: kamd_i, kamd_a, kamd_res
+
+      ! ---- One-time setup: upload ion list, open file, write header + roster ----
+      if (total_nstep .eq. 0) then
+        call gpu_kamd_ion_setup(kamd_ion_atoms, kamd_nions)
+
+        open(newunit=kamd_ion_traj_unit, file=trim(ion_traj_file), &
+             status='replace', action='write')
+        kamd_ion_traj_open = .true.
+
+        write(kamd_ion_traj_unit, '(a)') '# kamd ion trajectory'
+        write(kamd_ion_traj_unit, '(a,i0,a,f8.5,a,i0,a)') &
+            '# membrane_axis = ', membrane_axis, '   dt = ', dt, &
+            ' ps   ion_traj_outfreq = ', ion_traj_outfreq, ' steps'
+        write(kamd_ion_traj_unit, '(a)') &
+            '# per frame: 1 FRAME line (step, time_ps, memCOM_x memCOM_y memCOM_z, Lx Ly Lz)'
+        write(kamd_ion_traj_unit, '(a)') &
+            '#          + N ion lines (atom_index atom_name x y z , Angstrom, UNWRAPPED image coords)'
+        write(kamd_ion_traj_unit, '(a)') '# ion roster: index atom_name residue charge(e)'
+        do kamd_i = 1, kamd_nions
+          kamd_a = kamd_ion_atoms(kamd_i)
+          kamd_res = 1
+          do while (kamd_res .lt. nres .and. kamd_a .ge. gbl_res_atms(kamd_res + 1))
+            kamd_res = kamd_res + 1
+          end do
+          write(kamd_ion_traj_unit, '(a,i10,1x,a4,1x,a4,1x,f8.4)') '#   ', &
+              kamd_a, atm_igraph(kamd_a), gbl_labres(kamd_res), &
+              atm_qterm(kamd_a) * ONE_AMBER_ELECTROSTATIC
+        end do
+      end if
+
+      ! ---- Per-cadence frame write ----
+      if (mod(total_nstep + 1, ion_traj_outfreq) .eq. 0) then
+        call gpu_kamd_ion_gather(kamd_ion_xyz, kamd_com, &
+                                 kamd_membrane_start, kamd_membrane_end)
+
+        write(kamd_ion_traj_unit, '(a,i12,1x,f12.3,3(1x,f12.4),3(1x,f9.3))') &
+            'FRAME ', total_nstep + 1, t, kamd_com(1), kamd_com(2), kamd_com(3), &
+            pbc_box(1), pbc_box(2), pbc_box(3)
+        do kamd_i = 1, kamd_nions
+          write(kamd_ion_traj_unit, '(i10,1x,a4,3(1x,f10.3))') &
+              kamd_ion_atoms(kamd_i), atm_igraph(kamd_ion_atoms(kamd_i)), &
+              kamd_ion_xyz(1, kamd_i), kamd_ion_xyz(2, kamd_i), kamd_ion_xyz(3, kamd_i)
+        end do
+        flush(kamd_ion_traj_unit)
+      end if
+
+      ! ---- Close on normal completion (flush each frame protects against walltime kill) ----
+      if (kamd_ion_traj_open .and. (total_nstep + 1) .ge. total_nstlim) then
+        close(kamd_ion_traj_unit)
+        kamd_ion_traj_open = .false.
+      end if
+
+    end block
+  end if
+#endif
+
+
       ! Do the velocity update:
 #ifdef MPI
       if (vv==1) then
